    {
      "id": "chukyu.lesson.2.grammar.0",
      "titleJa": "～というN／～っていうN",
      "paragraphIds": [
        "chukyu.lesson.2.grammar.0.meaning",
        "chukyu.lesson.2.grammar.0.connection",
        "chukyu.lesson.2.grammar.0.note"
      ],
      "examples": [
        {
          "ja": "ベトナムでは、「4」という数字はいい数字の1つだと考えられている。",
          "translationId": "chukyu.lesson.2.grammar.0.example.0"
        },
        {
          "ja": "この計画には賛成できないという意見が多い。",
          "translationId": "chukyu.lesson.2.grammar.0.example.1"
        },
        {
          "ja": "昨日、今年の冬は暖冬だという予想が発表された。",
          "translationId": "chukyu.lesson.2.grammar.0.example.2"
        },
        {
          "ja": "A：山田さんっていう人知っている？ B：ううん、誰？",
          "translationId": "chukyu.lesson.2.grammar.0.example.3"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.2.grammar.1",
      "titleJa": "Vること／Nほど～はない・いない",
      "paragraphIds": [
        "chukyu.lesson.2.grammar.1.meaning",
        "chukyu.lesson.2.grammar.1.connection",
        "chukyu.lesson.2.grammar.1.note"
      ],
      "examples": [
        {
          "ja": "中国語圏ほど「いい数字」にこだわるところはない。",
          "translationId": "chukyu.lesson.2.grammar.1.example.0"
        },
        {
          "ja": "本を読むことほど楽しいことはない。",
          "translationId": "chukyu.lesson.2.grammar.1.example.1"
        },
        {
          "ja": "佐藤さんほどまじめに勉強する人はいない。",
          "translationId": "chukyu.lesson.2.grammar.1.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.2.grammar.2",
      "titleJa": "Vる／Vないほど；ぐらい・くらい",
      "paragraphIds": [
        "chukyu.lesson.2.grammar.2.meaning",
        "chukyu.lesson.2.grammar.2.connection",
        "chukyu.lesson.2.grammar.2.note"
      ],
      "examples": [
        {
          "ja": "数千万円以上というびっくりするほどの値段がついた。",
          "translationId": "chukyu.lesson.2.grammar.2.example.0"
        },
        {
          "ja": "友達の引っ越しを手伝って、死ぬほど疲れた。",
          "translationId": "chukyu.lesson.2.grammar.2.example.1"
        },
        {
          "ja": "大きな地震で立っていられないほど揺れた。",
          "translationId": "chukyu.lesson.2.grammar.2.example.2"
        },
        {
          "ja": "数千万円以上というびっくりするぐらいの値段がついた。",
          "translationId": "chukyu.lesson.2.grammar.2.example.3"
        },
        {
          "ja": "昨日一日中歩いたので、今朝は足が痛くて、立てないぐらいだった。",
          "translationId": "chukyu.lesson.2.grammar.2.example.4"
        }
      ],
      "children": []
    },
