  "articles": [
    {
      "id": "chukyu.lesson.4.grammar.0",
      "titleJa": "Vたとたん",
      "paragraphIds": [
        "chukyu.lesson.4.grammar.0.meaning",
        "chukyu.lesson.4.grammar.0.connection",
        "chukyu.lesson.4.grammar.0.note"
      ],
      "examples": [
        {
          "ja": "まぶしいと感じたとたん、「はくしょん」とくしゃみが飛びだす。",
          "translationId": "chukyu.lesson.4.grammar.0.example.0"
        },
        {
          "ja": "学生たちは終了ベルが鳴ったとたん、教室を出て行った。",
          "translationId": "chukyu.lesson.4.grammar.0.example.1"
        },
        {
          "ja": "彼は布団に入ったとたん、寝てしまった。",
          "translationId": "chukyu.lesson.4.grammar.0.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.4.grammar.1",
      "titleJa": "复合動詞：Vます語幹＋だす・込む",
      "paragraphIds": [
        "chukyu.lesson.4.grammar.1.meaning",
        "chukyu.lesson.4.grammar.1.connection",
        "chukyu.lesson.4.grammar.1.note"
      ],
      "examples": [
        {
          "ja": "まぶしいと感じたとたん、くしゃみが飛びだす。",
          "translationId": "chukyu.lesson.4.grammar.1.example.0"
        },
        {
          "ja": "電車に乗ったとたん、彼はかばんからタブレットを取りだした。",
          "translationId": "chukyu.lesson.4.grammar.1.example.1"
        },
        {
          "ja": "突然雨が降りだした。",
          "translationId": "chukyu.lesson.4.grammar.1.example.2"
        },
        {
          "ja": "冷たい空気を吸い込む。",
          "translationId": "chukyu.lesson.4.grammar.1.example.3"
        },
        {
          "ja": "とても暑いので、プールに飛び込んだ。",
          "translationId": "chukyu.lesson.4.grammar.1.example.4"
        },
        {
          "ja": "マラソンの選手たちは大会のために毎日練習し、走り込んでいる。",
          "translationId": "chukyu.lesson.4.grammar.1.example.5"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.4.grammar.2",
      "titleJa": "N／Vる＋とともに",
      "paragraphIds": [
        "chukyu.lesson.4.grammar.2.meaning",
        "chukyu.lesson.4.grammar.2.connection",
        "chukyu.lesson.4.grammar.2.note"
      ],
      "examples": [
        {
          "ja": "鼻に入った異物を鼻水とともに外に押しだそうとする。",
          "translationId": "chukyu.lesson.4.grammar.2.example.0"
        },
        {
          "ja": "ボランティアの仲間とともに、町のイベントを成功させた。",
          "translationId": "chukyu.lesson.4.grammar.2.example.1"
        },
        {
          "ja": "電車の事故があった。会社は事故原因を調べるとともに、電車の復旧作業を進めている。",
          "translationId": "chukyu.lesson.4.grammar.2.example.2"
        },
        {
          "ja": "人口が増えるとともに、ごみ問題が起きている。",
          "translationId": "chukyu.lesson.4.grammar.2.example.3"
        },
        {
          "ja": "景気の回復とともに、家を買う人が増えている。",
          "translationId": "chukyu.lesson.4.grammar.2.example.4"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.4.grammar.3",
      "titleJa": "助詞＋の：での・からの・までの・との・への",
      "paragraphIds": [
