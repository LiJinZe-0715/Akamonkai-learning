      "examples": [
        {
          "ja": "まぶしいと感じたとたん、「はくしょん」とくしゃみが飛びだす。",
          "translationId": "chukyu.lesson.4.grammar.5.example.0"
        },
        {
          "ja": "隣の家の犬が「ワンワン」とほえて、うるさい。",
          "translationId": "chukyu.lesson.4.grammar.5.example.1"
        },
        {
          "ja": "鼻がむずむずして、くしゃみが出る。",
