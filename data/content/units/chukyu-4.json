      ],
      "examples": [
        {
          "ja": "目からの「まぶしい」という信号が脳に伝わる。",
          "translationId": "chukyu.lesson.4.grammar.3.example.0"
        },
        {
          "ja": "両親との暮らしが懐かしい。",
          "translationId": "chukyu.lesson.4.grammar.3.example.1"
        },
        {
          "ja": "タイへの卒業旅行を楽しみにしている。",
          "translationId": "chukyu.lesson.4.grammar.3.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.4.grammar.4",
      "titleJa": "Vる／Nの＋途中",
      "paragraphIds": [
        "chukyu.lesson.4.grammar.4.meaning",
