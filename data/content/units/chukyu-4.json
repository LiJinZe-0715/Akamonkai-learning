    {
      "id": "chukyu.lesson.4.exercises",
      "titleJa": "教材の穴埋め練習",
      "paragraphIds": [
        "chukyu.lesson.4.exerciseInstructions"
      ],
      "examples": [
        {
          "ja": "鼻がむずむずして、くしゃみが（　　　）。",
          "answerJa": "飛び出す",
          "analysisId": "chukyu.lesson.4.exercise.0.note"
        },
        {
          "ja": "あなたの国ではくしゃみの音をどう（　　　）か。",
          "answerJa": "表します",
          "analysisId": "chukyu.lesson.4.exercise.1.note"
        },
        {
          "ja": "「光くしゃみ反射」の症状は子孫に（　　　）そうだ。",
          "answerJa": "遺伝する",
          "analysisId": "chukyu.lesson.4.exercise.2.note"
        },
        {
          "ja": "この掃除機はごみを（　　　）パワーがすごい。",
          "answerJa": "吸い込む",
          "analysisId": "chukyu.lesson.4.exercise.3.note"
        },
        {
          "ja": "あの親子は声が（　　　）だ。",
          "answerJa": "そっくり",
          "analysisId": "chukyu.lesson.4.exercise.4.note"
        },
        {
          "ja": "私が日本語の勉強を始めた（　　　）は日本のアニメを見たことだ。",
          "answerJa": "きっかけ",
          "analysisId": "chukyu.lesson.4.exercise.5.note"
        },
        {
          "ja": "日本ではボーナスが年2回出るのが（　　　）ようだ。",
          "answerJa": "一般的な",
          "analysisId": "chukyu.lesson.4.exercise.6.note"
        },
        {
          "ja": "日本ではくしゃみの音は「はくしょん」と表すが、（　　　）音はどうだろうか。",
          "answerJa": "実際の",
          "analysisId": "chukyu.lesson.4.exercise.7.note"
        }
      ],
      "children": []
    }
