  "articles": [
    {
      "id": "n2.day1-mono.grammar.0",
      "titleJa": "～ものだ",
      "paragraphIds": [
        "n2.day1-mono.grammar.0.anchor",
        "n2.day1-mono.grammar.0.logic",
        "n2.day1-mono.grammar.0.connection",
        "n2.day1-mono.grammar.0.contrast"
      ],
      "examples": [
        {
          "ja": "人は誰でも失敗するものだ。",
          "translationId": "n2.day1-mono.grammar.0.translation"
        },
        {
          "ja": "赤ちゃんは夜泣きするものだ。",
          "translationId": "n2.day1-mono.grammar.0.translation.1"
        },
        {
          "ja": "年を取ると、時間がたつのが早いものだ。",
          "translationId": "n2.day1-mono.grammar.0.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.1",
      "titleJa": "～たものだ",
      "paragraphIds": [
        "n2.day1-mono.grammar.1.anchor",
        "n2.day1-mono.grammar.1.logic",
        "n2.day1-mono.grammar.1.connection",
        "n2.day1-mono.grammar.1.contrast"
      ],
      "examples": [
        {
          "ja": "子供のころ、この川でよく泳いだものだ。",
          "translationId": "n2.day1-mono.grammar.1.translation"
        },
        {
          "ja": "学生時代は、夜遅くまで友達と話したものだ。",
          "translationId": "n2.day1-mono.grammar.1.translation.1"
        },
        {
          "ja": "昔はこの辺りも静かだったものだ。",
          "translationId": "n2.day1-mono.grammar.1.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.2",
      "titleJa": "～ものだから",
      "paragraphIds": [
        "n2.day1-mono.grammar.2.anchor",
        "n2.day1-mono.grammar.2.logic",
        "n2.day1-mono.grammar.2.connection",
        "n2.day1-mono.grammar.2.contrast"
      ],
      "examples": [
        {
          "ja": "朝寝坊したものだから、電車に乗り遅れてしまった。",
          "translationId": "n2.day1-mono.grammar.2.translation"
        },
        {
          "ja": "道が込んでいたものだから、約束に遅れてしまいました。",
          "translationId": "n2.day1-mono.grammar.2.translation.1"
        },
        {
          "ja": "日本語がまだよく分からないものだから、ゆっくり話していただけませんか。",
          "translationId": "n2.day1-mono.grammar.2.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.3",
      "titleJa": "～ものの",
      "paragraphIds": [
        "n2.day1-mono.grammar.3.anchor",
        "n2.day1-mono.grammar.3.logic",
        "n2.day1-mono.grammar.3.connection",
        "n2.day1-mono.grammar.3.contrast"
      ],
      "examples": [
        {
          "ja": "免許は取ったものの、ほとんど運転していない。",
          "translationId": "n2.day1-mono.grammar.3.translation"
        },
        {
          "ja": "新しい薬を試したものの、効果はなかった。",
          "translationId": "n2.day1-mono.grammar.3.translation.1"
        },
        {
          "ja": "会社には戻ったものの、以前と同じ仕事は任されなかった。",
          "translationId": "n2.day1-mono.grammar.3.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.4",
      "titleJa": "～ものなら／～ようものなら",
      "paragraphIds": [
        "n2.day1-mono.grammar.4.anchor",
        "n2.day1-mono.grammar.4.logic",
        "n2.day1-mono.grammar.4.connection",
        "n2.day1-mono.grammar.4.contrast"
      ],
      "examples": [
        {
          "ja": "できるものなら、もう一度学生時代に戻りたい。",
          "translationId": "n2.day1-mono.grammar.4.translation"
        },
        {
          "ja": "この秘密を彼に話そうものなら、家中に広まってしまう。",
          "translationId": "n2.day1-mono.grammar.4.translation.1"
        },
        {
          "ja": "社長の前でそんなことを言おうものなら、すぐに首になるよ。",
          "translationId": "n2.day1-mono.grammar.4.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.5",
      "titleJa": "～ものを",
      "paragraphIds": [
        "n2.day1-mono.grammar.5.anchor",
        "n2.day1-mono.grammar.5.logic",
        "n2.day1-mono.grammar.5.connection",
        "n2.day1-mono.grammar.5.contrast"
      ],
      "examples": [
        {
          "ja": "先に言ってくれれば手伝ったものを。",
          "translationId": "n2.day1-mono.grammar.5.translation"
        },
        {
          "ja": "黙っていればいいものを、余計なことを言ってしまった。",
          "translationId": "n2.day1-mono.grammar.5.translation.1"
        },
        {
          "ja": "電話一本くれれば迎えに行ったものを。",
          "translationId": "n2.day1-mono.grammar.5.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.6",
      "titleJa": "～ものではない",
      "paragraphIds": [
        "n2.day1-mono.grammar.6.anchor",
        "n2.day1-mono.grammar.6.logic",
        "n2.day1-mono.grammar.6.connection",
        "n2.day1-mono.grammar.6.contrast"
      ],
      "examples": [
        {
          "ja": "人の悪口を言うものではない。",
          "translationId": "n2.day1-mono.grammar.6.translation"
        },
        {
          "ja": "若いうちは、楽な道ばかり選ぶものではない。",
          "translationId": "n2.day1-mono.grammar.6.translation.1"
        },
        {
          "ja": "目上の人に向かって、そんな口のきき方をするものではない。",
          "translationId": "n2.day1-mono.grammar.6.translation.2"
        }
      ],
      "children": []
    },
    {
      "id": "n2.day1-mono.grammar.7",
      "titleJa": "～というものだ",
      "paragraphIds": [
        "n2.day1-mono.grammar.7.anchor",
        "n2.day1-mono.grammar.7.logic",
        "n2.day1-mono.grammar.7.connection",
        "n2.day1-mono.grammar.7.contrast"
      ],
      "examples": [
        {
          "ja": "困っている人を黙って助ける。これこそ親切というものだ。",
          "translationId": "n2.day1-mono.grammar.7.translation"
        },
        {
          "ja": "一度決めたことを最後までやり遂げる。それが責任というものだ。",
          "translationId": "n2.day1-mono.grammar.7.translation.1"
        },
        {
          "ja": "自分の意見を言わずに人の顔色ばかりうかがうのは、協調ではなく服従というものだ。",
          "translationId": "n2.day1-mono.grammar.7.translation.2"
        }
      ],
      "children": []
    }
  ],
