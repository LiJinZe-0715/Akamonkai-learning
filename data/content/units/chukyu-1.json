  "articles": [
    {
      "id": "chukyu.lesson.1.grammar.0",
      "titleJa": "カタカナ語／Nって何ですか",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.0.meaning",
        "chukyu.lesson.1.grammar.0.connection",
        "chukyu.lesson.1.grammar.0.note"
      ],
      "examples": [
        {
          "ja": "コンサートって何ですか。音楽会のことです。",
          "translationId": "chukyu.lesson.1.grammar.0.example.0"
        },
        {
          "ja": "ストレスがたまった時に、音楽を聞いて、気持ちをリラックスさせるという人が多い。",
          "translationId": "chukyu.lesson.1.grammar.0.example.1"
        },
        {
          "ja": "いらいらした時はカラオケが一番だ。",
          "translationId": "chukyu.lesson.1.grammar.0.example.2"
        },
        {
          "ja": "夏休みにはロック・フェスティバルに行くつもりだ。",
          "translationId": "chukyu.lesson.1.grammar.0.example.3"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.1",
      "titleJa": "～だろう",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.1.meaning",
        "chukyu.lesson.1.grammar.1.connection",
        "chukyu.lesson.1.grammar.1.note"
      ],
      "examples": [
        {
          "ja": "「音楽療法」の最も簡単な方法は「聞く」ことだろう。",
          "translationId": "chukyu.lesson.1.grammar.1.example.0"
        },
        {
          "ja": "外国語を習得するための一番いい方法はその国へ行くことだろう。",
          "translationId": "chukyu.lesson.1.grammar.1.example.1"
        },
        {
          "ja": "今度の音楽会には有名な歌手が出るので、来場者はきっと多いだろう。",
          "translationId": "chukyu.lesson.1.grammar.1.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.2",
      "titleJa": "～のだろうか",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.2.meaning",
        "chukyu.lesson.1.grammar.2.connection",
        "chukyu.lesson.1.grammar.2.note"
      ],
      "examples": [
        {
          "ja": "音楽療法は、どんな音楽を聞いたらいいのだろうか。",
          "translationId": "chukyu.lesson.1.grammar.2.example.0"
        },
        {
          "ja": "敬語の使い方は難しい。どうやったら覚えられるのだろうか。",
          "translationId": "chukyu.lesson.1.grammar.2.example.1"
        },
        {
          "ja": "リラックスするためには、何をするのが効果的なのだろうか。",
          "translationId": "chukyu.lesson.1.grammar.2.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.3",
      "titleJa": "～わけがない",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.3.meaning",
        "chukyu.lesson.1.grammar.3.connection",
        "chukyu.lesson.1.grammar.3.note"
      ],
      "examples": [
        {
          "ja": "嫌いな音楽を聞いてもリラックスできるわけがない。",
          "translationId": "chukyu.lesson.1.grammar.3.example.0"
        },
        {
          "ja": "サッカー好きな彼がこの試合を見ないわけがない。",
          "translationId": "chukyu.lesson.1.grammar.3.example.1"
        },
        {
          "ja": "いつも忙しそうに仕事をしている彼女が暇なわけがない。",
          "translationId": "chukyu.lesson.1.grammar.3.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.4",
      "titleJa": "「わけがない・わけではない」の整理",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.4.meaning",
        "chukyu.lesson.1.grammar.4.connection",
        "chukyu.lesson.1.grammar.4.note"
      ],
      "examples": [
        {
          "ja": "こんな高いレストランで毎日食事できるわけがない。",
          "translationId": "chukyu.lesson.1.grammar.4.example.0"
        },
        {
          "ja": "料理はするが、毎日するわけではない。",
          "translationId": "chukyu.lesson.1.grammar.4.example.1"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.5",
      "titleJa": "名詞修飾節の「が」→「の」",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.5.meaning",
        "chukyu.lesson.1.grammar.5.connection",
        "chukyu.lesson.1.grammar.5.note"
      ],
      "examples": [
        {
          "ja": "自分の好きな音楽を聞くことこそ、心のいやしになるのである。",
          "translationId": "chukyu.lesson.1.grammar.5.example.0"
        },
        {
          "ja": "私の住む町について説明しましょう。",
          "translationId": "chukyu.lesson.1.grammar.5.example.1"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.6",
      "titleJa": "Vること／N＋こそ",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.6.meaning",
        "chukyu.lesson.1.grammar.6.connection",
        "chukyu.lesson.1.grammar.6.note"
      ],
      "examples": [
        {
          "ja": "自分の好きな音楽を聞くことこそ、心のいやしになるのである。",
          "translationId": "chukyu.lesson.1.grammar.6.example.0"
        },
        {
          "ja": "漢字は毎日書くことこそ、覚える秘訣だ。",
          "translationId": "chukyu.lesson.1.grammar.6.example.1"
        },
        {
          "ja": "今度の試験こそ頑張りたい。",
          "translationId": "chukyu.lesson.1.grammar.6.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.7",
      "titleJa": "動詞の省略",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.7.meaning",
        "chukyu.lesson.1.grammar.7.connection",
        "chukyu.lesson.1.grammar.7.note"
      ],
      "examples": [
        {
          "ja": "クラシックが好きな人はクラシックを（聞き）、演歌が好きな人は演歌を聞くのが効果的な方法だ。",
          "translationId": "chukyu.lesson.1.grammar.7.example.0"
        },
        {
          "ja": "お酒が飲める人はお酒を（注文し）、飲めない人はジュースを注文した。",
          "translationId": "chukyu.lesson.1.grammar.7.example.1"
        },
        {
          "ja": "学校にはいつもは歩いて（通い）、雨の日はバスで学校に通っている。",
          "translationId": "chukyu.lesson.1.grammar.7.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.grammar.8",
      "titleJa": "より～",
      "paragraphIds": [
        "chukyu.lesson.1.grammar.8.meaning",
        "chukyu.lesson.1.grammar.8.connection",
        "chukyu.lesson.1.grammar.8.note"
      ],
      "examples": [
        {
          "ja": "音楽・音がどのような効果をもたらすか、今後、より注目されていくだろう。",
          "translationId": "chukyu.lesson.1.grammar.8.example.0"
        },
        {
          "ja": "日本語の勉強は中級に入ると、より難しくなる。",
          "translationId": "chukyu.lesson.1.grammar.8.example.1"
        },
        {
          "ja": "リサイクル運動をより多くの人に知ってもらいたい。",
          "translationId": "chukyu.lesson.1.grammar.8.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.1.exercises",
      "titleJa": "教材の穴埋め練習",
      "paragraphIds": [
        "chukyu.lesson.1.exerciseInstructions"
      ],
      "examples": [
        {
          "ja": "音楽療法がどんな効果を（　　　）か、注目されている。",
          "answerJa": "もたらす",
          "analysisId": "chukyu.lesson.1.exercise.0.note"
        },
        {
          "ja": "毎日忙しくて、ストレスが（　　　）いる。",
          "answerJa": "たまって",
          "analysisId": "chukyu.lesson.1.exercise.1.note"
        },
        {
          "ja": "子供たちは歌に（　　　）、手遊びをする。",
          "answerJa": "合わせて",
          "analysisId": "chukyu.lesson.1.exercise.2.note"
        },
        {
          "ja": "疲れている時、波や小鳥の声に（　　　）。",
          "answerJa": "いやされる",
          "analysisId": "chukyu.lesson.1.exercise.3.note"
        },
        {
          "ja": "「音楽療法」の方法で（　　　）簡単な方法は「聞く」ことだ。",
          "answerJa": "最も",
          "analysisId": "chukyu.lesson.1.exercise.4.note"
        },
        {
          "ja": "漢字を覚えるためには（　　　）方法がある。",
          "answerJa": "さまざまな",
          "analysisId": "chukyu.lesson.1.exercise.5.note"
        },
        {
          "ja": "日本へ来たばかりの時は、日本語が全然分からなかったが、（　　　）簡単な話が分かるようになった。",
          "answerJa": "次第に",
          "analysisId": "chukyu.lesson.1.exercise.6.note"
        },
        {
          "ja": "自分の好きな音楽を聞くことは心のいやしになる。（　　　）クラシックが好きな人にはクラシックを聞くのが効果的だ。",
          "answerJa": "したがって",
          "analysisId": "chukyu.lesson.1.exercise.7.note"
        }
      ],
      "children": []
    }
