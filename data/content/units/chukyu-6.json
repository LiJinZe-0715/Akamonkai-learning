      ],
      "examples": [
        {
          "ja": "本当だとしたら、200年以上もその効果が続いていることになる。",
          "translationId": "chukyu.lesson.6.grammar.4.example.0"
        },
        {
          "ja": "生まれ変わるとしたら、女性がいいですか、男性がいいですか。",
          "translationId": "chukyu.lesson.6.grammar.4.example.1"
        },
        {
          "ja": "今年も留学するのが無理だとしたら、今度こそ就職しなければならない。",
          "translationId": "chukyu.lesson.6.grammar.4.example.2"
        }
      ],
