              "kind": "sentence",
              "text": "スーツがなかったら買わなくてもいいけど、大学の入学式には学生らしい服を着て行ったほうがいいよ。",
              "translationId": "topic-1-6.6-reading.grammar.3.example.12.translation",
              "analysisId": "topic-1-6.6-reading.grammar.3.example.12.analysis"
            }
