    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0",
          "title": "会話：就職活動（1）",
          "lines": [
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.0.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "ねえ、サークルのみんなで旅行に行かない？"
                },
                {
                  "kind": "sentence",
                  "text": " 私もアメリカに留学しちゃったら、みんなにも簡単に会えなくなるし…。"
                },
                {
                  "kind": "sentence",
                  "text": "去年京都に行ったきり、今年はどこも行っていないし…。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.1.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "悪いけど、就職先もまだ決まらないのに、旅行どころじゃないよ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.2.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そうか…。"
                },
                {
                  "kind": "sentence",
                  "text": "ゲーム会社に入りたいんだったよね。"
                },
                {
                  "kind": "sentence",
                  "text": "どう？"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.3.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "うーん。"
                },
                {
                  "kind": "sentence",
                  "text": "いろいろ情報は集めているものの、なかなか厳しくて…。"
                },
                {
                  "kind": "sentence",
                  "text": "困ったことにこの業界、募集はどこも「若干名」なんだよ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.4.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "へえ。"
                },
                {
                  "kind": "sentence",
                  "text": "人気の業界にしては、求人少ないんだね。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-1.dialogue.0.line.5.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "求人があるところは全部応募して、自己PR何回書いたことか。"
                }
              ]
            }
