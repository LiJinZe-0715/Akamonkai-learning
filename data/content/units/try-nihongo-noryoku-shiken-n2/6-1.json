    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0",
          "title": "会話：苦労した5年間（1）",
          "lines": [
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.0.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "とうとう明日ね。"
                },
                {
                  "kind": "sentence",
                  "text": "初めてのプレゼン。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.1.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "うん。"
                },
                {
                  "kind": "sentence",
                  "text": "会社に入って5年、経験がなかったばかりに苦労したよ。"
                },
                {
                  "kind": "sentence",
                  "text": "でも、自分の夢をあきらめることはないって君が言ってくれたから。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.2.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "ほんとに大変そうだったけどね。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.3.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "初めは同期の人に比べて、知識も技術も足りなかったからね。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.4.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そう。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.5.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "部長に何度もやり直しさせられたけど、負けるものかと思って、がんばってきたんだ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.line.6.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "部長は、1日も早くあなたにプロの仕事ができるようになってほしかったのよ。"
                },
                {
                  "kind": "sentence",
                  "text": "それが上司というものよ。"
                }
              ]
            }
          ],
          "questions": [],
          "introductionId": "try-nihongo-noryoku-shiken-n2.6-1.dialogue.0.introduction"
        }
      ]
    },
    "grammar": {
      "kind": "grammar-module",
      "items": [
        {
          "kind": "grammar",
          "id": "try-nihongo-noryoku-shiken-n2.6-1.grammar.0",
          "title": "48 経験がなかったばかりに",
          "examples": [
            {
              "kind": "sentence",
              "text": "本当のことを言ったばかりに、彼を怒らせてしまった。",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.grammar.0.example.0.translation"
            },
            {
              "kind": "sentence",
              "text": "背が2センチ足りないばかりに、警察官になれなかった。",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-1.grammar.0.example.1.translation"
            },
