    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0",
          "title": "会話：就職活動（2）",
          "lines": [
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.line.0.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "難しいね。"
                },
                {
                  "kind": "sentence",
                  "text": "やる気さえあれば、採用してもらえるというものじゃないだろうし。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.line.1.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そうなんだよ。"
                },
                {
                  "kind": "sentence",
                  "text": "募集がなければがんばりようがないし…。"
                },
                {
                  "kind": "sentence",
                  "text": "このままゲーム会社にこだわって、さんざん苦労したあげく、どこにも就職できなかったらどうしようと思ったりして…。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.line.2.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そんなこと考えるもんじゃないよ。"
                },
                {
                  "kind": "sentence",
                  "text": "成功するって信じなきゃ。"
                },
                {
                  "kind": "sentence",
                  "text": "せめて先輩も、絶対だめだと思ったけど出すだけ出してみるって言って、結局その会社に入れたんだって。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.line.3.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "へえ、そうなんだ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.line.4.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "だから、とにかくあきらめないで、最後までがんばろうよ。"
                },
                {
                  "kind": "sentence",
                  "text": "ね。"
                }
              ]
            }
          ],
          "questions": [],
          "introductionId": "try-nihongo-noryoku-shiken-n2.5-2.dialogue.0.introduction"
        }
      ]
    },
