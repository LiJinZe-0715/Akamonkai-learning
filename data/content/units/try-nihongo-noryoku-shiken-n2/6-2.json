    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0",
          "title": "会話：苦労した5年間（2）",
          "lines": [
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.0.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "部長はぼくのことを思えばこそ、厳しく言ってくれたんだよね。"
                },
                {
                  "kind": "sentence",
                  "text": "部長の気持ちもわからないことはなかったけど、つらかったよ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.1.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そうね。"
                },
                {
                  "kind": "sentence",
                  "text": "つらそうだったね。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.2.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "でも、一度決めたことだから、がんばれるだけがんばろうと思って…。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.3.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "そうよね。"
                },
                {
                  "kind": "sentence",
                  "text": "あんなに努力してたんだもん。"
                },
                {
                  "kind": "sentence",
                  "text": "いつか認めてもらえると思ってたよ。"
                }
              ]
            },
            {
              "role": "木山",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.4.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "ずっと応援してくれた君のためにも、明日は失敗するわけにはいかない。"
                },
                {
                  "kind": "sentence",
                  "text": "こうなったら自分を信じて進むのみだ。"
                },
                {
                  "kind": "sentence",
                  "text": "ハリウッド映画のスターになったつもりで、最高にかっこよくプレゼンするよ。"
                }
              ]
            },
            {
              "role": "渡辺",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.line.5.translation",
              "sentences": [
                {
                  "kind": "sentence",
                  "text": "うん。"
                },
                {
                  "kind": "sentence",
                  "text": "がんばってね。"
                }
              ]
            }
          ],
          "questions": [],
          "introductionId": "try-nihongo-noryoku-shiken-n2.6-2.dialogue.0.introduction"
        }
      ]
    },
    "grammar": {
      "kind": "grammar-module",
      "items": [
        {
          "kind": "grammar",
          "id": "try-nihongo-noryoku-shiken-n2.6-2.grammar.0",
          "title": "53 ぼくのことを思えばこそ",
          "examples": [
            {
              "kind": "sentence",
              "text": "この山の自然を愛すればこそ、観光客の数を厳しく制限しているのです。",
              "translationId": "try-nihongo-noryoku-shiken-n2.6-2.grammar.0.example.0.translation"
            },
