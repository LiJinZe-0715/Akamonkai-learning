    {
      "id": "topic.6.reading.examples",
      "titleJa": "例文の解説",
      "paragraphIds": [],
      "examples": [
        {
          "ja": "「上の学校に進学させてください。」と頼みましたが、祖父の強い反対で家の仕事をすることになりました。",
          "translationId": "topic.6.reading.example.0.zh",
          "analysisId": "topic.6.reading.example.0.analysis"
        },
        {
          "ja": "しかし、元気をなくした賢治のことを心配した母親の力で、翌年やっと盛岡高等農林学校に進むことができました。",
          "translationId": "topic.6.reading.example.1.zh",
          "analysisId": "topic.6.reading.example.1.analysis"
        },
        {
          "ja": "学校では化学や地学を教えながら、学生たちに自分の作った劇を練習させたり、自分の詩や童話を聞かせたりすることもありました。",
          "translationId": "topic.6.reading.example.2.zh",
          "analysisId": "topic.6.reading.example.2.analysis"
        },
        {
          "ja": "あまり先生らしくない先生で、誤解を受けたこともありましたが、家庭ではいつもおもしろい話をして、母親や妹を笑わせました。",
          "translationId": "topic.6.reading.example.3.zh",
          "analysisId": "topic.6.reading.example.3.analysis"
        },
        {
          "ja": "賢治は大正13年（1924）に詩集と童話集を１冊ずつ出しました。",
          "translationId": "topic.6.reading.example.4.zh",
          "analysisId": "topic.6.reading.example.4.analysis"
        },
        {
          "ja": "田舎の無名の詩人の出したこの本は文学界の人々を驚かせましたが、ほとんど売れませんでした。",
          "translationId": "topic.6.reading.example.5.zh",
          "analysisId": "topic.6.reading.example.5.analysis"
        },
        {
          "ja": "大正15年（1926）には教師をやめ、農民とともに生きようとしました。しかし、彼は農民にもあまり理解してもらえませんでした。",
          "translationId": "topic.6.reading.example.6.zh",
          "analysisId": "topic.6.reading.example.6.analysis"
        },
        {
          "ja": "賢治は昭和８年（1933）に37歳の若さで亡くなりましたが、独創的で幻想的な彼の作品は彼の死後、多くの人々を感動させ、映画にもなりました。",
          "translationId": "topic.6.reading.example.7.zh",
          "analysisId": "topic.6.reading.example.7.analysis"
        },
        {
          "ja": "ジョンさんはとても男らしい人で、女の子に人気がある。",
          "translationId": "topic.6.reading.example.8.zh",
          "analysisId": "topic.6.reading.example.8.analysis"
        },
        {
          "ja": "ここは山や川があって、田舎らしい景色だ。",
          "translationId": "topic.6.reading.example.9.zh",
          "analysisId": "topic.6.reading.example.9.analysis"
        },
        {
          "ja": "今日は暖かくて、春らしい日だね。",
          "translationId": "topic.6.reading.example.10.zh",
          "analysisId": "topic.6.reading.example.10.analysis"
        },
        {
          "ja": "友子ちゃん、ズボンばかりはかないで、もっと女の子らしい服を着たらどう？",
          "translationId": "topic.6.reading.example.11.zh",
          "analysisId": "topic.6.reading.example.11.analysis"
        },
        {
          "ja": "スーツがなかったら買わなくてもいいけど、大学の入学式には学生らしい服を着て行ったほうがいいよ。",
          "translationId": "topic.6.reading.example.12.zh",
          "analysisId": "topic.6.reading.example.12.analysis"
        }
      ],
      "children": []
