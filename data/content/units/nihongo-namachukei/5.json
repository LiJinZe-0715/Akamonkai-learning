{
  "kind": "lesson",
  "id": "nihongo-namachukei.5",
  "bookId": "nihongo-namachukei",
  "title": "LESSON 5 買い物",
  "modules": {
    "articles": {
      "kind": "article-module",
      "items": [
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.0",
          "title": "聞き取り練習 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.0",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.1",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、いらっしゃいませ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.2",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、着物みたいなのを探してるんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.3",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あっ、着物でございますか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.4",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あー、いえ、えっと、あれは着物じゃないと思うんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.5",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.6",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、温泉に行ったときに、着る…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.7",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あー、浴衣でございますね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.8",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "浴衣？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.9",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "浴衣でしたら、こちらになりますが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.10",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" },
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.11",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.12",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "ここはこれだけですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.13",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "そうですね。3階のほうにはもっとたくさんございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.0.paragraph.14",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あー、そうですか。じゃあ、そっちのも見てみます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.1",
          "title": "聞き取り練習 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.0",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "ねえ、裕子さん、これなんか、どうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.1",
              "role": "裕子",
              "sentences": [
                { "kind": "sentence", "text": "どれどれ？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.2",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "このスカーフ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.3",
              "role": "裕子",
              "sentences": [
                { "kind": "sentence", "text": "うーん。色は、いいと思うんだけど。高島さん、こういう花のデザイン、好きじゃないような気がするなー。財布とか、名刺入れとかのほうが、仕事にも使えていいんじゃない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.4",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "そうですか？　でも、高島さん、ときどき花柄のブラウスのときがありますよ。ほら、こないだのプレゼンの日にも花柄のブラウス着てたじゃないですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.5",
              "role": "裕子",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そういえばそうだったね。で、それ、いくらなの？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.6",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "えっと、65ユーロって書いてますけど。今、ユーロ高いから、日本円だと1万円ぐらいかな。でも、日本で買うともっと高いし…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.7",
              "role": "裕子",
              "sentences": [
                { "kind": "sentence", "text": "うん、そうだね。高島さんにはいろいろお世話になってるしね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.8",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "それに、デューティーフリーだから、税金はかかんないですしね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.9",
              "role": "裕子",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。じゃあ、これにしよっか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.1.paragraph.10",
              "role": "有里",
              "sentences": [
                { "kind": "sentence", "text": "はい、そうですね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.2",
          "title": "聞き取り練習 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.0",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "ねえ、どの問題集がいいかなあ。たくさんありすぎて、迷うな。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.1",
              "role": "健太",
              "sentences": [
                { "kind": "sentence", "text": "そうだな。うーんと、あっ、これなんかどう？　この本、けっこう有名みたいだよ。「語彙・文法・読解」って書いてあるし、全部勉強できて、いいんじゃない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.2",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "でもさー、これって上級者向けじゃない？　あんまり難しいの買っても、レベルが合わなきゃ、意味ないしね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.3",
              "role": "健太",
              "sentences": [
                { "kind": "sentence", "text": "うん、確かに。じゃあ、どのレベルがいいの？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.4",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "中級ぐらいかな。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.5",
              "role": "健太",
              "sentences": [
                { "kind": "sentence", "text": "中級ねー。あっ、なんか向こうの棚に、「フランス語試験対策」って書いてあるよ。あっちの見てみる？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.6",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.7",
              "role": "健太",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これとかは？　この『初級が終わった人のフランス語』って本。文法も読解もリスニングもあるし、音声もダウンロードできるみたいだし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.8",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。音声があるのはいいよね。レベルも…、私にはちょうどいいみたい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.9",
              "role": "健太",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、これにしたら？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.2.paragraph.10",
              "role": "由美",
              "sentences": [
                { "kind": "sentence", "text": "うん、じゃあ、これにしよ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.3",
          "title": "聞き取り練習 ④",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.0",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.1",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.2",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "ちょっとお尋ねしたいんですが、こっちの背の低いタンスと、こっちの少し濃い色のとでは、色以外に何が違うんですか。" },
                { "kind": "sentence", "text": "デザインは同じみたいなんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.3",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あー、ローチェストですね。" },
                { "kind": "sentence", "text": "実は、脚の部分のデザインが少し違うんです。" },
                { "kind": "sentence", "text": "引き出しの数と大きさは同じなんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.4",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あー、なるほど…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.5",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "こちらのほうは、丸い脚がついていますけど、こちらの濃いほうは、四角い脚の形になっています。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.6",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ…そうなんですね。" },
                { "kind": "sentence", "text": "気付きませんでした。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.7",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" },
                { "kind": "sentence", "text": "価格は同じなんですが、色を選ぶことはできなくて、丸い脚のほうも、四角い脚のほうも、色はこの色しかないんです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.8",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "わかりました。" },
                { "kind": "sentence", "text": "じゃあ、こっちの丸い脚のほうにしよっかな。" },
                { "kind": "sentence", "text": "部屋の雰囲気にも合いそうだし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.3.paragraph.9",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" },
                { "kind": "sentence", "text": "では、こちらのほうへどうぞ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.4",
          "title": "重要表現 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.0",
              "section": "人にすすめる",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "このセーター、黒いのと赤いのとどっちがいいと思う？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。黒いほうがいいんじゃない？　いろんな色の服に合わせやすいし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、そうしよっかな。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.3",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "どんなプレゼントがいいと思う？　もう、わかんなくなっちゃった。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.4",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "じゃあさー、ネクタイにするってのは？　ネクタイなら、何本あっても困らないし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.5",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うん、そうだね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.6",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ノートパソコン、そろそろ買い替えようって思ってるんだけど、何がいいかさっぱりわからなくて。" },
                { "kind": "sentence", "text": "なんか、おすすめってある？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "僕は、ノートパソコンはとにかく軽いのが好みなんですけど。" },
                { "kind": "sentence", "text": "軽さでいくなら、やっぱり、僕が今持ってるのなんか、どうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.8",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うーん、軽さも大事なんだけど、私には、スクリーンの大きさのほうが重要かなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.4.paragraph.9",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。" },
                { "kind": "sentence", "text": "じゃあ…" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.5",
          "title": "重要表現 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.0",
              "section": "相手の意見を聞いて何にするか決める",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "いかがなさいますか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えーっと、こっちにします。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.2",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "これなんか、どうでしょうか。" },
                { "kind": "sentence", "text": "今とても人気の商品となっております。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.3",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、それにしてみようかなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.4",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "このペン、ほんと使いやすいですよ。" },
                { "kind": "sentence", "text": "私、リピーターなんです。" },
                { "kind": "sentence", "text": "ちょっと使ってみます？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.5.paragraph.5",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これいいですね。" },
                { "kind": "sentence", "text": "次、買うとき、これ買おっかなあ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.5.article.6",
          "title": "重要表現 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.0",
              "section": "すすめを断る",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "父の日のプレゼントは、ポロシャツがいいんじゃない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "うーん。でもそれって、普通すぎない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.2",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "先生への贈り物は、部屋で使える花瓶か何かにしない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.3",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そうですね。でも、花瓶はやめたほうがよくないですか。" },
                { "kind": "sentence", "text": "先生の部屋に花があったことってないですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.4",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "小春ちゃんへのプレゼント、アクセサリーってのは？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.5",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "どうかなあ、" },
                { "kind": "sentence", "text": "アクセサリーって好みがあるから、別の物のほうがいいような気がするなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.6",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "木村さんの送別会ですけど、マグカップとか写真立てとか、何かプレゼント、用意します？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.5.article.6.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そうですね。" },
                { "kind": "sentence", "text": "あとに残る物よりもお花か何かのほうがいいような気がしますけど。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    },
    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.0",
          "title": "聞き取り練習 ①",
          "lines": [
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、いらっしゃいませ。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、着物みたいなのを探してるんですが。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、着物でございますか。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、いえ、えっと、あれは着物じゃないと思うんだけど。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "はあ。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、温泉に行ったときに、着る…。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、浴衣でございますね。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "浴衣？" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "浴衣でしたら、こちらになりますが。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "ここはこれだけですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.14.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですね。3階のほうにはもっとたくさんございます。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.0.line.15.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、そうですか。じゃあ、そっちのも見てみます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.1",
          "title": "聞き取り練習 ②",
          "lines": [
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ねえ、裕子さん、これなんか、どうですか。" }
              ]
            },
            {
              "role": "裕子",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "どれどれ？" }
              ]
            },
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "このスカーフ。" }
              ]
            },
            {
              "role": "裕子",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "うーん。色は、いいと思うんだけど。高島さん、こういう花のデザイン、好きじゃないような気がするなー。財布とか、名刺入れとかのほうが、仕事にも使えていいんじゃない？" }
              ]
            },
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですか？　でも、高島さん、ときどき花柄のブラウスのときがありますよ。ほら、こないだのプレゼンの日にも花柄のブラウス着てたじゃないですか。" }
              ]
            },
            {
              "role": "裕子",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そういえばそうだったね。で、それ、いくらなの？" }
              ]
            },
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、65ユーロって書いてますけど。今、ユーロ高いから、日本円だと1万円ぐらいかな。でも、日本で買うともっと高いし…。" }
              ]
            },
            {
              "role": "裕子",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、そうだね。高島さんにはいろいろお世話になってるしね。" }
              ]
            },
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "それに、デューティーフリーだから、税金はかかんないですしね。" }
              ]
            },
            {
              "role": "裕子",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。じゃあ、これにしよっか。" }
              ]
            },
            {
              "role": "有里",
              "translationId": "nihongo-namachukei.5.dialogue.1.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、そうですね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.2",
          "title": "聞き取り練習 ③",
          "lines": [
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ねえ、どの問題集がいいかなあ。たくさんありすぎて、迷うな。" }
              ]
            },
            {
              "role": "健太",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだな。うーんと、あっ、これなんかどう？　この本、けっこう有名みたいだよ。「語彙・文法・読解」って書いてあるし、全部勉強できて、いいんじゃない？" }
              ]
            },
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "でもさー、これって上級者向けじゃない？　あんまり難しいの買っても、レベルが合わなきゃ、意味ないしね。" }
              ]
            },
            {
              "role": "健太",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、確かに。じゃあ、どのレベルがいいの？" }
              ]
            },
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "中級ぐらいかな。" }
              ]
            },
            {
              "role": "健太",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "中級ねー。あっ、なんか向こうの棚に、「フランス語試験対策」って書いてあるよ。あっちの見てみる？" }
              ]
            },
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "健太",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これとかは？　この『初級が終わった人のフランス語』って本。文法も読解もリスニングもあるし、音声もダウンロードできるみたいだし。" }
              ]
            },
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。音声があるのはいいよね。レベルも…、私にはちょうどいいみたい。" }
              ]
            },
            {
              "role": "健太",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、これにしたら？" }
              ]
            },
            {
              "role": "由美",
              "translationId": "nihongo-namachukei.5.dialogue.2.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、じゃあ、これにしよ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.3",
          "title": "聞き取り練習 ④",
          "lines": [
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "ちょっとお尋ねしたいんですが、こっちの背の低いタンスと、こっちの少し濃い色のとでは、色以外に何が違うんですか。" },
                { "kind": "sentence", "text": "デザインは同じみたいなんですけど。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、ローチェストですね。" },
                { "kind": "sentence", "text": "実は、脚の部分のデザインが少し違うんです。" },
                { "kind": "sentence", "text": "引き出しの数と大きさは同じなんですけど。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、なるほど…。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "こちらのほうは、丸い脚がついていますけど、こちらの濃いほうは、四角い脚の形になっています。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ…そうなんですね。" },
                { "kind": "sentence", "text": "気付きませんでした。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" },
                { "kind": "sentence", "text": "価格は同じなんですが、色を選ぶことはできなくて、丸い脚のほうも、四角い脚のほうも、色はこの色しかないんです。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "わかりました。" },
                { "kind": "sentence", "text": "じゃあ、こっちの丸い脚のほうにしよっかな。" },
                { "kind": "sentence", "text": "部屋の雰囲気にも合いそうだし。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.5.dialogue.3.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" },
                { "kind": "sentence", "text": "では、こちらのほうへどうぞ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.4",
          "title": "重要表現 ①",
          "lines": [
            {
              "section": "人にすすめる",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.4.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "このセーター、黒いのと赤いのとどっちがいいと思う？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.4.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。黒いほうがいいんじゃない？　いろんな色の服に合わせやすいし。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.4.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、そうしよっかな。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.5.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "どんなプレゼントがいいと思う？　もう、わかんなくなっちゃった。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.5.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあさー、ネクタイにするってのは？　ネクタイなら、何本あっても困らないし。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.5.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、そうだね。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.6.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ノートパソコン、そろそろ買い替えようって思ってるんだけど、何がいいかさっぱりわからなくて。" },
                { "kind": "sentence", "text": "なんか、おすすめってある？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.6.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "僕は、ノートパソコンはとにかく軽いのが好みなんですけど。" },
                { "kind": "sentence", "text": "軽さでいくなら、やっぱり、僕が今持ってるのなんか、どうですか。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.6.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うーん、軽さも大事なんだけど、私には、スクリーンの大きさのほうが重要かなあ。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.6.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。" },
                { "kind": "sentence", "text": "じゃあ…" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.5",
          "title": "重要表現 ②",
          "lines": [
            {
              "section": "相手の意見を聞いて何にするか決める",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.7.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "いかがなさいますか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.7.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えーっと、こっちにします。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.8.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "これなんか、どうでしょうか。" },
                { "kind": "sentence", "text": "今とても人気の商品となっております。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.8.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、それにしてみようかなあ。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.9.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "このペン、ほんと使いやすいですよ。" },
                { "kind": "sentence", "text": "私、リピーターなんです。" },
                { "kind": "sentence", "text": "ちょっと使ってみます？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.9.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これいいですね。" },
                { "kind": "sentence", "text": "次、買うとき、これ買おっかなあ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.5.dialogue.6",
          "title": "重要表現 ③",
          "lines": [
            {
              "section": "すすめを断る",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.5.dialogue.10.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "父の日のプレゼントは、ポロシャツがいいんじゃない？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.5.dialogue.10.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "うーん。でもそれって、普通すぎない？" }
              ]
            },
            {
