{
  "kind": "lesson",
  "id": "nihongo-namachukei.7",
  "bookId": "nihongo-namachukei",
  "title": "LESSON 7 ほめられて",
  "modules": {
    "articles": {
      "kind": "article-module",
      "items": [
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.0",
          "title": "聞き取り練習 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.0",
              "role": "弟",
              "sentences": [
                { "kind": "sentence", "text": "あれ、お姉ちゃん、髪型、変えた？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.1",
              "role": "姉",
              "sentences": [
                { "kind": "sentence", "text": "うん。変じゃない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.2",
              "role": "弟",
              "sentences": [
                { "kind": "sentence", "text": "変じゃないよ。けっこう似合ってるって思うよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.3",
              "role": "姉",
              "sentences": [
                { "kind": "sentence", "text": "よかった。なんか、心配してたんだ。美容院、変えたから、似合ってないかもしれないって心配だったんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.4",
              "role": "弟",
              "sentences": [
                { "kind": "sentence", "text": "心配することなかった、似合ってるから。それに、前より、だいぶやせて見えるし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.5",
              "role": "姉",
              "sentences": [
                { "kind": "sentence", "text": "それどういう意味よ。やせて見えるって。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.6",
              "role": "弟",
              "sentences": [
                { "kind": "sentence", "text": "だって、そうだから。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.0.paragraph.7",
              "role": "姉",
              "sentences": [
                { "kind": "sentence", "text": "ほんと、一言多いんだから。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.1",
          "title": "聞き取り練習 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.0",
              "role": "篠山",
              "sentences": [
                { "kind": "sentence", "text": "あっ、真野さん、かばん、買ったんですか。すてきですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.1",
              "role": "真野",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。この赤い色が一目で気に入っちゃって。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.2",
              "role": "篠山",
              "sentences": [
                { "kind": "sentence", "text": "ええ、そうですね。それに、形もいいですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.3",
              "role": "真野",
              "sentences": [
                { "kind": "sentence", "text": "ええ、そうなんですよ。A4サイズが入るし、それに、底が広いからお弁当もそのまま入れられて、便利なんです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.4",
              "role": "篠山",
              "sentences": [
                { "kind": "sentence", "text": "お弁当が入るんですか。いいですねぇ。私もそういうの探してるんですよね。それ、ネットですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.5",
              "role": "真野",
              "sentences": [
                { "kind": "sentence", "text": "いえ、駅前のかばん屋さんです。ほら、店の前にかばんがたくさん並べてある店、あるでしょ？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.6",
              "role": "篠山",
              "sentences": [
                { "kind": "sentence", "text": "あー、はい。ありますね。あの店、中に入ったことなかったんですけど、いいものあるんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.7",
              "role": "真野",
              "sentences": [
                { "kind": "sentence", "text": "ええ、いろんなかばんが置いてあるからおもしろいですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.1.paragraph.8",
              "role": "篠山",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですか。じゃあ、今度一度入ってみます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.2",
          "title": "聞き取り練習 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.0",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "おー、高木。聞いたぞ。昨日のプレゼン、すごくよかったんだって？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.1",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "えっ？ 誰がそんなこと…" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.2",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "山岸。スライドなんて完璧だったって言ってたよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.3",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "それほどじゃないよ。まあ、変な質問が出なかったのはラッキーだったかな。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.4",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "お前、スライドとか作んの、得意なんだな。俺、ああいうの苦手でさ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.5",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "ああ、そうなんだな。俺、スライドは問題ないんだけど、しゃべるのがさ… だから前の日はずっと練習したよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.6",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.7",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.8",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "なあ、今晩時間ある？ 俺、来週プレゼンがあるんだけど、スライド作んの、ちょっと手伝ってくんない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.9",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "今晩？ ああ、いいよ。バイトもないし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.10",
              "role": "佐藤",
              "sentences": [
                { "kind": "sentence", "text": "おー、助かる。じゃ、6時の授業終わったら、連絡するわ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.2.paragraph.11",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "オッケー。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.3",
          "title": "聞き取り練習 ④",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.0",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "木村さん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.1",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.2",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "最近、テニスの腕、上がったんじゃないですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.3",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.4",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "ええ。ずいぶん上達したと思いますよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.5",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "ここ1か月ほど、先生に教えていただいたイメージトレーニングをやってるんですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.6",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "へー、イメージトレーニング、あれ、いいでしょ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.7",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.8",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "みなさん、最初は信じてくれないんですけど、やってみると、効果があるんですよね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.9",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "そう、そう、そうなんです。ほんと、コーチのおかげです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.10",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "いやいや、おかげなんて。木村さんのがんばりですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.11",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "そんなことないです。でも、そう言っていただけると、励みになります。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.12",
              "role": "コーチ",
              "sentences": [
                { "kind": "sentence", "text": "このまま行くと、次の大会、優勝も夢じゃないんじゃないですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.3.paragraph.13",
              "role": "木村",
              "sentences": [
                { "kind": "sentence", "text": "いやー、そこまでは。でも、優勝目指してがんばります。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.4",
          "title": "重要表現 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.0",
              "section": "ほめる",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うわー、よかった。田中君って、ほんと歌うまいね。声もいいし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "いやー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "もう一曲歌ってよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.3",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そう？ じゃあ…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.4",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "最近、料理の腕、上がったんじゃない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.5",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そう思う？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.6",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うん、前もおいしかったけど、さらにおいしくなった気がする。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "よし！ 前はさ、分量とか順番とか適当だったんだけど、最近ちゃんとレシピを見て作るようにしてるんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.8",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ふうん、それだけでけっこう変わるんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.9",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あれ？ 髪型変りました？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.10",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.11",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そのヘアスタイル、木村さんにすごく似合ってますね。いい感じ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.12",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ほんと？ ありがとう。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.13",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "山田さん、そのネクタイ、おしゃれですね。スーツにも合ってます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.14",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そう？ 僕のネクタイ、地味だって言って、妻が買ってきたんだけど、派手じゃないかなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.4.paragraph.15",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そんなことないですよ。奥さん、趣味がいいですね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.7.article.5",
          "title": "重要表現 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.0",
              "section": "ほめに応える",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そのジーンズ、いいね。すごく似合ってるね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そう？ ありがとう。日曜日に買ったんだ。色が気に入ってる。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うん、すごくいいよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.3",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "みきさん、英語、ほんとに上手だね。発音がネイティブみたい。それだけ話せたら、通訳もできるね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.4",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そんな、通訳は無理だよ。もっと勉強しないと、単語がぜんぜん足りないし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.5",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そうかなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.6",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "山田さんのお宅って、いつもきれいに片付いてますね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えーっ、そうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.8",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ええ、それに家具のセンスもいいし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.9",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あー、家具はね、夫が好きで…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.10",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんですか。うちは全然そういうの興味なくて。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.11",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "今日のプレゼン、わかりやすかったですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.12",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。ありがとうございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.13",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "話のスピードもちょうどよかったし、グラフも見やすくて、完璧でしたね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.7.article.5.paragraph.14",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。そう言っていただけると、励みになります。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    },
    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.0",
          "title": "聞き取り練習 ①",
          "lines": [
            {
              "role": "弟",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あれ、お姉ちゃん、髪型、変えた？" }
              ]
            },
            {
              "role": "姉",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。変じゃない？" }
              ]
            },
            {
              "role": "弟",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "変じゃないよ。けっこう似合ってるって思うよ。" }
              ]
            },
            {
              "role": "姉",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "よかった。なんか、心配してたんだ。美容院、変えたから、似合ってないかもしれないって心配だったんだけど。" }
              ]
            },
            {
              "role": "弟",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "心配することなかった、似合ってるから。それに、前より、だいぶやせて見えるし。" }
              ]
            },
            {
              "role": "姉",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "それどういう意味よ。やせて見えるって。" }
              ]
            },
            {
              "role": "弟",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "だって、そうだから。" }
              ]
            },
            {
              "role": "姉",
              "translationId": "nihongo-namachukei.7.dialogue.0.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "ほんと、一言多いんだから。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.1",
          "title": "聞き取り練習 ②",
          "lines": [
            {
              "role": "篠山",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、真野さん、かばん、買ったんですか。すてきですね。" }
              ]
            },
            {
              "role": "真野",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。この赤い色が一目で気に入っちゃって。" }
              ]
            },
            {
              "role": "篠山",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、そうですね。それに、形もいいですね。" }
              ]
            },
            {
              "role": "真野",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、そうなんですよ。A4サイズが入るし、それに、底が広いからお弁当もそのまま入れられて、便利なんです。" }
              ]
            },
            {
              "role": "篠山",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "お弁当が入るんですか。いいですねぇ。私もそういうの探してるんですよね。それ、ネットですか。" }
              ]
            },
            {
              "role": "真野",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "いえ、駅前のかばん屋さんです。ほら、店の前にかばんがたくさん並べてある店、あるでしょ？" }
              ]
            },
            {
              "role": "篠山",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、はい。ありますね。あの店、中に入ったことなかったんですけど、いいものあるんですか。" }
              ]
            },
            {
              "role": "真野",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、いろんなかばんが置いてあるからおもしろいですよ。" }
              ]
            },
            {
              "role": "篠山",
              "translationId": "nihongo-namachukei.7.dialogue.1.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですか。じゃあ、今度一度入ってみます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.2",
          "title": "聞き取り練習 ③",
          "lines": [
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "おー、高木。聞いたぞ。昨日のプレゼン、すごくよかったんだって？" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ？ 誰がそんなこと…" }
              ]
            },
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "山岸。スライドなんて完璧だったって言ってたよ。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "それほどじゃないよ。まあ、変な質問が出なかったのはラッキーだったかな。" }
              ]
            },
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "お前、スライドとか作んの、得意なんだな。俺、ああいうの苦手でさ。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "ああ、そうなんだな。俺、スライドは問題ないんだけど、しゃべるのがさ… だから前の日はずっと練習したよ。" }
              ]
            },
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "なあ、今晩時間ある？ 俺、来週プレゼンがあるんだけど、スライド作んの、ちょっと手伝ってくんない？" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "今晩？ ああ、いいよ。バイトもないし。" }
              ]
            },
            {
              "role": "佐藤",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "おー、助かる。じゃ、6時の授業終わったら、連絡するわ。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.7.dialogue.2.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "オッケー。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.3",
          "title": "聞き取り練習 ④",
          "lines": [
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "木村さん。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "最近、テニスの腕、上がったんじゃないですか。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そうですか。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。ずいぶん上達したと思いますよ。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "ここ1か月ほど、先生に教えていただいたイメージトレーニングをやってるんですよ。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "へー、イメージトレーニング、あれ、いいでしょ。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "みなさん、最初は信じてくれないんですけど、やってみると、効果があるんですよね。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "そう、そう、そうなんです。ほんと、コーチのおかげです。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "いやいや、おかげなんて。木村さんのがんばりですよ。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "そんなことないです。でも、そう言っていただけると、励みになります。" }
              ]
            },
            {
              "role": "コーチ",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "このまま行くと、次の大会、優勝も夢じゃないんじゃないですか。" }
              ]
            },
            {
              "role": "木村",
              "translationId": "nihongo-namachukei.7.dialogue.3.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "いやー、そこまでは。でも、優勝目指してがんばります。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.4",
          "title": "重要表現 ①",
          "lines": [
            {
              "section": "ほめる",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.4.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "うわー、よかった。田中君って、ほんと歌うまいね。声もいいし。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.4.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "いやー。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.4.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "もう一曲歌ってよ。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.4.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そう？ じゃあ…。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.5.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "最近、料理の腕、上がったんじゃない？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.5.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、そう思う？" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.5.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、前もおいしかったけど、さらにおいしくなった気がする。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.5.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "よし！ 前はさ、分量とか順番とか適当だったんだけど、最近ちゃんとレシピを見て作るようにしてるんだ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.5.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "ふうん、それだけでけっこう変わるんだ。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.6.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あれ？ 髪型変りました？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.6.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんです。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.6.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "そのヘアスタイル、木村さんにすごく似合ってますね。いい感じ。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.7.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ほんと？ ありがとう。" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.7.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "山田さん、そのネクタイ、おしゃれですね。スーツにも合ってます。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.7.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "そう？ 僕のネクタイ、地味だって言って、妻が買ってきたんだけど、派手じゃないかなあ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.7.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "そんなことないですよ。奥さん、趣味がいいですね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.7.dialogue.5",
          "title": "重要表現 ②",
          "lines": [
            {
              "section": "ほめに応える",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.8.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "そのジーンズ、いいね。すごく似合ってるね。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.8.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "そう？ ありがとう。日曜日に買ったんだ。色が気に入ってる。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.8.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、すごくいいよ。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.9.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "みきさん、英語、ほんとに上手だね。発音がネイティブみたい。それだけ話せたら、通訳もできるね。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.9.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "そんな、通訳は無理だよ。もっと勉強しないと、単語がぜんぜん足りないし。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.9.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうかなあ。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.10.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "山田さんのお宅って、いつもきれいに片付いてますね。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.10.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えーっ、そうですか。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.10.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、それに家具のセンスもいいし。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.10.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、家具はね、夫が好きで…。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.10.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんですか。うちは全然そういうの興味なくて。" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.11.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "今日のプレゼン、わかりやすかったですね。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.11.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。ありがとうございます。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.7.dialogue.11.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "話のスピードもちょうどよかったし、グラフも見やすくて、完璧でしたね。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.7.dialogue.11.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。そう言っていただけると、励みになります。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    }
  }
}
