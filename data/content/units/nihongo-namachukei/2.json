{
  "kind": "lesson",
  "id": "nihongo-namachukei.2",
  "bookId": "nihongo-namachukei",
  "title": "LESSON 2 予定を変更する",
  "modules": {
    "articles": {
      "kind": "article-module",
      "items": [
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.0",
          "title": "聞き取り練習 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.0",
              "role": "夫",
              "sentences": [
                { "kind": "sentence", "text": "なあ、日曜日に子どもたちと遊園地に行くことになってたよな。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.1",
              "role": "妻",
              "sentences": [
                { "kind": "sentence", "text": "うん。あっ…、もしかして。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.2",
              "role": "夫",
              "sentences": [
                { "kind": "sentence", "text": "なあ、悪いんだけど、来週にしてもいい？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.3",
              "role": "妻",
              "sentences": [
                { "kind": "sentence", "text": "えーっ。 なんで？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.4",
              "role": "夫",
              "sentences": [
                { "kind": "sentence", "text": "どうしても、週末にやっちゃわないといけない仕事があってさ。 ほんと、子どもたちにも申し訳ないんだけど。 ほら、土曜日はおばあちゃんのお見舞いに行くことになってるだろ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.5",
              "role": "妻",
              "sentences": [
                { "kind": "sentence", "text": "なんとかがんばって、日曜日空けらんない？ 子どもたちも楽しみにしてるし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.6",
              "role": "夫",
              "sentences": [
                { "kind": "sentence", "text": "うーん、でも、仕事、たまってて、厳しいかなあ。 ほんと、ごめん。 来週の週末は絶対に空けとくからさー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.7",
              "role": "妻",
              "sentences": [
                { "kind": "sentence", "text": "来週、絶対だよ。 子どもたちには、自分でちゃんと説明してね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.0.paragraph.8",
              "role": "夫",
              "sentences": [
                { "kind": "sentence", "text": "うん、わかった。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.1",
          "title": "聞き取り練習 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.0",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "もしもし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.1",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "あー、三橋さん？ 大木ですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.2",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "あっ、大木さん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.3",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "あのう、今晩の、坂木室長の送別会なんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.4",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.5",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "子どもがちょっと熱、出しちゃいまして、妻が帰って来るまで出かけられないんですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.6",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.7",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "ええ、でも坂木さんにはご挨拶したいので、ちょっと遅くなるかもしれないんですが、伺おうと思っています。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.8",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "わかりました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.9",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "で、私を待たずに、先に始めといていただけますか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.10",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.11",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "時間は、7時からでしたよね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.12",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.13",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、すみませんが、みなさんにそう伝えていただけますか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.14",
              "role": "三橋",
              "sentences": [
                { "kind": "sentence", "text": "いいですよ。 じゃあ、お大事に。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.1.paragraph.15",
              "role": "大木",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。 申し訳ありませんが、よろしくお願いします。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.2",
          "title": "聞き取り練習 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.0",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "はい、もしもし。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.1",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "あっ、武？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.2",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "うん、美里、どうかした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.3",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、ごめん。今日の約束なんだけど、なんか頭が痛くって、薬飲んでも治らないんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.4",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "えー、大丈夫？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.5",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "うん、まあ。で、悪いんだけど、海に行くの、今日じゃなくて明日にしてもらえない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.6",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。いいよ。頭が痛いんじゃあ、楽しめないしね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.7",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "ほんとごめんね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.8",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "いいよ、いいよ。気にしないで。それより、ゆっくり休んだほうがいいよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.9",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "うん、ありがとう。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.10",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "夜になってもまだ具合悪かったら、明日も止めにしたほうがいいかもね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.11",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。じゃあ、また今晩電話するね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.12",
              "role": "武",
              "sentences": [
                { "kind": "sentence", "text": "うん。じゃあ、今日はゆっくりしなよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.2.paragraph.13",
              "role": "美里",
              "sentences": [
                { "kind": "sentence", "text": "うん、ありがと。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.3",
          "title": "聞き取り練習 ④",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.0",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、「焼き肉一番」でございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.1",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.2",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.3",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "明日土曜日の6時に予約を入れてた米田と言いますが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.4",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "米田様、はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.5",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "急なことで申し訳ないんですが、7時に変更は可能ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.6",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "少々お待ちください。今、確認いたします。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.7",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "はい、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.8",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "お待たせいたしました。あのう、土曜日ですのでちょっと混んでまして、7時半なら大丈夫なんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.9",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "7時半ですか。じゃあ、それでお願いします。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.3.paragraph.10",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "かしこまりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.4",
          "title": "重要表現 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.0",
              "section": "予定の変更を頼む",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "今日の打ち合わせなんですけど。急用が入ってしまって。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "それで、申し訳ないんですが、始まりの時間を30分遅らせていただけませんか。大丈夫ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.3",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "はい、わかりました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.4",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、土曜日の食事のことなんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.5",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あっ、どうかした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.6",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ちょっとさ、会社に行かなきゃならなくなっちゃって。で、申し訳ないんだけど、来週にしてもらってもいい？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "来週かー。ちょっと待って、スケジュール見るから。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.8",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのう、先生、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.9",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "はい、何ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.10",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのう、交換留学のことで、今日先生のところに伺うことになっていたと思うんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.11",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.12",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ビザのことで大使館に行かないといけなくなってしまって、大変申し訳ないんですが、別の日に　お願いできないでしょうか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.13",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "別の日って言うと、いつですか？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.14",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "はい、ヘアサロン・ティンクでございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.15",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あのう、今日の5時に予約を入れていた武田ですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.16",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あっ、お世話になっております。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.17",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "あのう、4時にしてもらえませんか。急で申し訳ないんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.4.paragraph.18",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "本日の4時ですね。はい、わかりました。お待ちしております。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.2.article.5",
          "title": "重要表現 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.0",
              "section": "できなくなった理由を説明する",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "今日の打ち合わせなんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "どうしたの？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "申し訳ないんですが、急用が入ってしまいまして。で、30分ほど遅れてしまうと思うんですが、みなさんにお伝えいただけますか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.3",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "はい、わかりました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.4",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのう、土曜日の映画のことなんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.5",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.6",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "仕事の都合で、土曜日は会社に行かなきゃいけなくなっちゃって。来週にしてもらえない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えー、そんなー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.8",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。今度おごるからさー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.9",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、日曜日の約束だけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.10",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えっ、何？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.11",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。日曜日、大阪に出張になっちゃって。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.12",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。仕事だったらしかたないよ。いいよ、いいよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.13",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。ほんとにごめん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.14",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "先生、すみません。今日、グループプロジェクトのことで、授業のあと先生の研究室に伺うことになってたんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.15",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.16",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "あのう、昨日から熱が下がらなくて。申し訳ありませんが、別の日にしていただくことは可能ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.2.article.5.paragraph.17",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ええ、いいですよ。大丈夫ですか。ちょっと待ってください。スケジュール見ますから。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    },
    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.0",
          "title": "聞き取り練習 ①",
          "lines": [
            {
              "role": "夫",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "なあ、日曜日に子どもたちと遊園地に行くことになってたよな。" }
              ]
            },
            {
              "role": "妻",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。あっ…、もしかして。" }
              ]
            },
            {
              "role": "夫",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "なあ、悪いんだけど、来週にしてもいい？" }
              ]
            },
            {
              "role": "妻",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "えーっ。 なんで？" }
              ]
            },
            {
              "role": "夫",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "どうしても、週末にやっちゃわないといけない仕事があってさ。 ほんと、子どもたちにも申し訳ないんだけど。 ほら、土曜日はおばあちゃんのお見舞いに行くことになってるだろ。" }
              ]
            },
            {
              "role": "妻",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "なんとかがんばって、日曜日空けらんない？ 子どもたちも楽しみにしてるし。" }
              ]
            },
            {
              "role": "夫",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "うーん、でも、仕事、たまってて、厳しいかなあ。 ほんと、ごめん。 来週の週末は絶対に空けとくからさー。" }
              ]
            },
            {
              "role": "妻",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "来週、絶対だよ。 子どもたちには、自分でちゃんと説明してね。" }
              ]
            },
            {
              "role": "夫",
              "translationId": "nihongo-namachukei.2.dialogue.0.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、わかった。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.1",
          "title": "聞き取り練習 ②",
          "lines": [
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "もしもし。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、三橋さん？ 大木ですけど。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、大木さん。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、今晩の、坂木室長の送別会なんですけど。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "子どもがちょっと熱、出しちゃいまして、妻が帰って来るまで出かけられないんですよ。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんですか。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、でも坂木さんにはご挨拶したいので、ちょっと遅くなるかもしれないんですが、伺おうと思っています。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "わかりました。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "で、私を待たずに、先に始めといていただけますか。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "時間は、7時からでしたよね。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、すみませんが、みなさんにそう伝えていただけますか。" }
              ]
            },
            {
              "role": "三橋",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.14.translation",
              "sentences": [
                { "kind": "sentence", "text": "いいですよ。 じゃあ、お大事に。" }
              ]
            },
            {
              "role": "大木",
              "translationId": "nihongo-namachukei.2.dialogue.1.line.15.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。 申し訳ありませんが、よろしくお願いします。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.2",
          "title": "聞き取り練習 ③",
          "lines": [
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、もしもし。" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、武？" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、美里、どうかした？" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、ごめん。今日の約束なんだけど、なんか頭が痛くって、薬飲んでも治らないんだ。" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "えー、大丈夫？" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、まあ。で、悪いんだけど、海に行くの、今日じゃなくて明日にしてもらえない？" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。いいよ。頭が痛いんじゃあ、楽しめないしね。" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "ほんとごめんね。" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "いいよ、いいよ。気にしないで。それより、ゆっくり休んだほうがいいよ。" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、ありがとう。" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "夜になってもまだ具合悪かったら、明日も止めにしたほうがいいかもね。" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだね。じゃあ、また今晩電話するね。" }
              ]
            },
            {
              "role": "武",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。じゃあ、今日はゆっくりしなよ。" }
              ]
            },
            {
              "role": "美里",
              "translationId": "nihongo-namachukei.2.dialogue.2.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、ありがと。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.3",
          "title": "聞き取り練習 ④",
          "lines": [
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、「焼き肉一番」でございます。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "明日土曜日の6時に予約を入れてた米田と言いますが。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "米田様、はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "急なことで申し訳ないんですが、7時に変更は可能ですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "少々お待ちください。今、確認いたします。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "お待たせいたしました。あのう、土曜日ですのでちょっと混んでまして、7時半なら大丈夫なんですが。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "7時半ですか。じゃあ、それでお願いします。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.2.dialogue.3.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "かしこまりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.4",
          "title": "重要表現 ①",
          "lines": [
            {
              "section": "予定の変更を頼む",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.8.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "今日の打ち合わせなんですけど。急用が入ってしまって。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.8.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.8.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "それで、申し訳ないんですが、始まりの時間を30分遅らせていただけませんか。大丈夫ですか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.8.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、わかりました。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.9.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、土曜日の食事のことなんだけど。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.9.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、どうかした？" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.9.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "ちょっとさ、会社に行かなきゃならなくなっちゃって。で、申し訳ないんだけど、来週にしてもらってもいい？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.9.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "来週かー。ちょっと待って、スケジュール見るから。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、先生、すみません。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、何ですか。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、交換留学のことで、今日先生のところに伺うことになっていたと思うんですが。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "ビザのことで大使館に行かないといけなくなってしまって、大変申し訳ないんですが、別の日に　お願いできないでしょうか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.10.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "別の日って言うと、いつですか？" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.11.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、ヘアサロン・ティンクでございます。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.11.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、今日の5時に予約を入れていた武田ですけど。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.11.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、お世話になっております。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.11.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、4時にしてもらえませんか。急で申し訳ないんですけど。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.11.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "本日の4時ですね。はい、わかりました。お待ちしております。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.2.dialogue.5",
          "title": "重要表現 ②",
          "lines": [
            {
              "section": "できなくなった理由を説明する",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.4.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "今日の打ち合わせなんですけど。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.4.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "どうしたの？" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.4.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "申し訳ないんですが、急用が入ってしまいまして。で、30分ほど遅れてしまうと思うんですが、みなさんにお伝えいただけますか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.4.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、わかりました。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.5.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、土曜日の映画のことなんだけど。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.5.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.5.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "仕事の都合で、土曜日は会社に行かなきゃいけなくなっちゃって。来週にしてもらえない？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.5.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "えー、そんなー。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.5.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。今度おごるからさー。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.6.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのさー、日曜日の約束だけど。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.6.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、何？" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.6.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。日曜日、大阪に出張になっちゃって。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.6.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。仕事だったらしかたないよ。いいよ、いいよ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.6.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "ごめん。ほんとにごめん。" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.7.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "先生、すみません。今日、グループプロジェクトのことで、授業のあと先生の研究室に伺うことになってたんですけど。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.7.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.2.dialogue.7.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、昨日から熱が下がらなくて。申し訳ありませんが、別の日にしていただくことは可能ですか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.2.dialogue.7.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ、いいですよ。大丈夫ですか。ちょっと待ってください。スケジュール見ますから。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    }
  }
}
