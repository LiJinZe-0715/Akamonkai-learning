{
  "kind": "lesson",
  "id": "nihongo-namachukei.4",
  "bookId": "nihongo-namachukei",
  "title": "LESSON 4 旅行の感想",
  "modules": {
    "articles": {
      "kind": "article-module",
      "items": [
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.0",
          "title": "聞き取り練習 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.0",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "みき。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.1",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "ん？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.2",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "はい、これ、お土産。気に入ってもらえるといいんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.3",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "うわー、かわいいー、ありがとう、ゆり。で、どうだった？ 初めての韓国は？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.4",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "よかったよー。食べ物とかもよかったけど、特に、買い物が。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.5",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "いいなあ。で、何買ったの？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.6",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "いろいろ。ジャケットとか、スーツとか。でね、日本語がけっこう通じるんだ。だから、旅行中、言葉で大変ってことはなかったよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.7",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。日本語、勉強してる人、多いからね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.8",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "それでね、居酒屋みたいなとこでご飯食べてたら、若い人が日本語で話しかけてきてくれて、それで、友達にもなれて…。で、昨日、その人からメールが来たんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.9",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "へえ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.10",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "でも、私の韓国語は全然だめだったけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.11",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、これからは、まじめに授業、受けなきゃね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.12",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "ほんと。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.13",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "韓国の友達か。私もほしいなあ。次の休みに韓国行こうかなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.14",
              "role": "ゆり",
              "sentences": [
                { "kind": "sentence", "text": "うん、私ももう一度行こうかなって思ってるんだ。一緒に行かない？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.0.paragraph.15",
              "role": "みき",
              "sentences": [
                { "kind": "sentence", "text": "うん、行く！" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.1",
          "title": "聞き取り練習 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.0",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "あれ、高木さん、少し焼けました？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.1",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "あっ、わかります？ いやあ、週末友達とキャンプに行ってたんですよ。で、帽子忘れちゃって…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.2",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうだったんですね。で、どうでした、キャンプは？ 楽しかったですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.3",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "それが、さんざんだったんですよ。今夏休みでしょ。渋滞がひどくって、キャンプ場まで行くのに5時間もかかっちゃって。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.4",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "5時間もですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.5",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですよ。それに、キャンプ場もすっごい人で、受付でも待たされるし。おまけに、夜もうるさくてうるさくて。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.6",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "えっ、何がですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.7",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "子どもたちがテントとテントの間を走り回ってたり、若い子たちが大きな音で音楽流してたりで、静かに夜空を眺めるっていう雰囲気じゃなかったんですよね。それを楽しみにして行ったんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.8",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "ああ、それは残念でしたね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.9",
              "role": "高木",
              "sentences": [
                { "kind": "sentence", "text": "まあ、都心から近い人気のキャンプ場を選んだってのが間違いだったんですけどね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.1.paragraph.10",
              "role": "佐々木",
              "sentences": [
                { "kind": "sentence", "text": "まあね…。でも、夏休みはどこに行っても人、多いですからね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.2",
          "title": "聞き取り練習 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.0",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "隣の青木です。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.1",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "あっ、青木さん。ちょっと、お待ちください。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.2",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "これ、お口に合うかどうかわかりませんが、どうぞ召し上がってください。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.3",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "いつも、いつも、ありがとうございます。どちらにいらっしゃったんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.4",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "マレーシアに行ってきたんですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.5",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "へえ、マレーシア。いかがでした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.6",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "あんなにきれいな海は、初めてでした。食べ物もおいしくて、とってもよかったですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.7",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。それはよかったですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.8",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "ええ。いい骨休めになりました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.9",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "でも、いいですね、海外旅行なんて。うらやましいですよ。私達、新婚旅行が最初で最後なんですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.10",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "お子さんが大きくなられたら、チャンスはいくらでもありますよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.11",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "そうですかー。あるといいんですけどね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.12",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "ありますよ。きっと。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.13",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "まあ、なんか、いつも珍しい物をいただいて、ありがとうございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.14",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "いえいえ、つまらない物ですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.15",
              "role": "高橋",
              "sentences": [
                { "kind": "sentence", "text": "そんなこと…。いつもありがとうございます。じゃあ、遠慮なく。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.2.paragraph.16",
              "role": "青木",
              "sentences": [
                { "kind": "sentence", "text": "ええ。留守中、お世話になりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.3",
          "title": "聞き取り練習 ④",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.0",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "失礼しまーす。営業って8人だったよね？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.1",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.2",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "これ、これ、みなさんでどうぞ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.3",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "あー、ありがとうございます。じゃあ、みんなでいただきます。課長、どこにいらっしゃったんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.4",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "日光。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.5",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "えっ、日光って、けっこう遠いですよね。ご家族でですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.6",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "うん。この連休を使ってね。日光、最高だったよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.7",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.8",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "1200年の歴史を感じたね。それに、建物もすごかったけど、やっぱり紅葉がきれいでよかったなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.9",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "でも、道、混んでませんでした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.10",
              "role": "山下",
              "sentences": [
                { "kind": "sentence", "text": "大丈夫だったよ。実は、連休で車が多いだろうって思って、朝4時に家を出てね。" },
                { "kind": "sentence", "text": "それで、渋滞には引っかからなかったんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.3.paragraph.11",
              "role": "岸田",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。でも、朝4時って大変でしたね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.4",
          "title": "重要表現 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.0",
              "section": "感想を述べる",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "キャンプはいかがでした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "天気もよかったですし、人も少なくて、よかったですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "それはそれは。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.3",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "ハワイ、どうでした？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.4",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "それが、観光客が多くてね。それに思ってたより物価も高くて。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.5",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そうでしたか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.6",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "京都に行ったんだよね。どうだった？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.7",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "もう最高。さすが、京都だね。あんなに歴史がある町は、京都だけだね。やっぱり、一番日本らしいよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.8",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "行ってよかったね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.9",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "北海道旅行、どうだった？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.10",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "食べ物は何でもおいしかったんだけどね。もう、寒くて寒くて。おまけに、手袋までなくしちゃってさー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.4.paragraph.11",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "そうだったんだ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.4.article.5",
          "title": "重要表現 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.0",
              "section": "うらやむ",
              "group": "①",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "沖縄、どうだった？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.1",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "海がきれいで、ウミガメも見られたんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.2",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "へえ、ウミガメか、いいなあ。僕も、一度は見てみたいなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.3",
              "group": "②",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "天神祭りの花火、すごかったよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.4",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "えーっ、うらやましいなあ。私も一緒に行けばよかったなあ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.5",
              "group": "③",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "どちらに行かれたんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.6",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "ミラノに行ってきたんです。初めての海外旅行だったんですよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.7",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "うわー、ミラノなんて、うらやましいです。私もいつか行けるといいんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.8",
              "group": "④",
              "role": "A",
              "sentences": [
                { "kind": "sentence", "text": "インドの国際会議でね、ガイドの人にタージ・マハルにも連れてってもらったんだよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.4.article.5.paragraph.9",
              "role": "B",
              "sentences": [
                { "kind": "sentence", "text": "うわー、タージ・マハルですか、いいですね。一度は行ってみたいところですよね。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    },
    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.0",
          "title": "聞き取り練習 ①",
          "lines": [
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "みき。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "ん？" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、これ、お土産。気に入ってもらえるといいんだけど。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "うわー、かわいいー、ありがとう、ゆり。で、どうだった？ 初めての韓国は？" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "よかったよー。食べ物とかもよかったけど、特に、買い物が。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "いいなあ。で、何買ったの？" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "いろいろ。ジャケットとか、スーツとか。でね、日本語がけっこう通じるんだ。だから、旅行中、言葉で大変ってことはなかったよ。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "そっかー。日本語、勉強してる人、多いからね。" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "それでね、居酒屋みたいなとこでご飯食べてたら、若い人が日本語で話しかけてきてくれて、それで、友達にもなれて…。で、昨日、その人からメールが来たんだ。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "へえ。" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "でも、私の韓国語は全然だめだったけど。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、これからは、まじめに授業、受けなきゃね。" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "ほんと。" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "韓国の友達か。私もほしいなあ。次の休みに韓国行こうかなあ。" }
              ]
            },
            {
              "role": "ゆり",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.14.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、私ももう一度行こうかなって思ってるんだ。一緒に行かない？" }
              ]
            },
            {
              "role": "みき",
              "translationId": "nihongo-namachukei.4.dialogue.0.line.15.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、行く！" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.1",
          "title": "聞き取り練習 ②",
          "lines": [
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あれ、高木さん、少し焼けました？" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、わかります？ いやあ、週末友達とキャンプに行ってたんですよ。で、帽子忘れちゃって…。" }
              ]
            },
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうだったんですね。で、どうでした、キャンプは？ 楽しかったですか。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "それが、さんざんだったんですよ。今夏休みでしょ。渋滞がひどくって、キャンプ場まで行くのに5時間もかかっちゃって。" }
              ]
            },
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "5時間もですか。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですよ。それに、キャンプ場もすっごい人で、受付でも待たされるし。おまけに、夜もうるさくてうるさくて。" }
              ]
            },
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、何がですか。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "子どもたちがテントとテントの間を走り回ってたり、若い子たちが大きな音で音楽流してたりで、静かに夜空を眺めるっていう雰囲気じゃなかったんですよね。それを楽しみにして行ったんですけど。" }
              ]
            },
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.1.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "ああ、それは残念でしたね。" }
              ]
            },
            {
              "role": "高木",
              "translationId": "nihongo-namachukei.4.dialogue.2.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "まあ、都心から近い人気のキャンプ場を選んだってのが間違いだったんですけどね。" }
              ]
            },
            {
              "role": "佐々木",
              "translationId": "nihongo-namachukei.4.dialogue.2.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "まあね…。でも、夏休みはどこに行っても人、多いですからね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.2",
          "title": "聞き取り練習 ③",
          "lines": [
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "隣の青木です。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、青木さん。ちょっと、お待ちください。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "これ、お口に合うかどうかわかりませんが、どうぞ召し上がってください。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "いつも、いつも、ありがとうございます。どちらにいらっしゃったんですか。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "マレーシアに行ってきたんですよ。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "へえ、マレーシア。いかがでした？" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あんなにきれいな海は、初めてでした。食べ物もおいしくて、とってもよかったですよ。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。それはよかったですね。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。いい骨休めになりました。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "でも、いいですね、海外旅行なんて。うらやましいですよ。私達、新婚旅行が最初で最後なんですよ。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "お子さんが大きくなられたら、チャンスはいくらでもありますよ。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですかー。あるといいんですけどね。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありますよ。きっと。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "まあ、なんか、いつも珍しい物をいただいて、ありがとうございます。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.14.translation",
              "sentences": [
                { "kind": "sentence", "text": "いえいえ、つまらない物ですけど。" }
              ]
            },
            {
              "role": "高橋",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.15.translation",
              "sentences": [
                { "kind": "sentence", "text": "そんなこと…。いつもありがとうございます。じゃあ、遠慮なく。" }
              ]
            },
            {
              "role": "青木",
              "translationId": "nihongo-namachukei.4.dialogue.3.line.16.translation",
              "sentences": [
                { "kind": "sentence", "text": "ええ。留守中、お世話になりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.3",
          "title": "聞き取り練習 ④",
          "lines": [
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "失礼しまーす。営業って8人だったよね？" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "これ、これ、みなさんでどうぞ。" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、ありがとうございます。じゃあ、みんなでいただきます。課長、どこにいらっしゃったんですか。" }
              ]
            },
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "日光。" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、日光って、けっこう遠いですよね。ご家族でですか。" }
              ]
            },
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。この連休を使ってね。日光、最高だったよ。" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですね。" }
              ]
            },
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "1200年の歴史を感じたね。それに、建物もすごかったけど、やっぱり紅葉がきれいでよかったなあ。" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "でも、道、混んでませんでした？" }
              ]
            },
            {
              "role": "山下",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "大丈夫だったよ。実は、連休で車が多いだろうって思って、朝4時に家を出てね。" },
                { "kind": "sentence", "text": "それで、渋滞には引っかからなかったんだ。" }
              ]
            },
            {
              "role": "岸田",
              "translationId": "nihongo-namachukei.4.dialogue.4.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうですか。でも、朝4時って大変でしたね。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.4",
          "title": "重要表現 ①",
          "lines": [
            {
              "section": "感想を述べる",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.10.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "キャンプはいかがでした？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.10.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "天気もよかったですし、人も少なくて、よかったですよ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.10.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "それはそれは。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.11.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ハワイ、どうでした？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.11.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "それが、観光客が多くてね。それに思ってたより物価も高くて。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.11.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうでしたか。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.12.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "京都に行ったんだよね。どうだった？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.12.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "もう最高。さすが、京都だね。あんなに歴史がある町は、京都だけだね。やっぱり、一番日本らしいよ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.12.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "行ってよかったね。" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.5.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "北海道旅行、どうだった？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.5.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "食べ物は何でもおいしかったんだけどね。もう、寒くて寒くて。おまけに、手袋までなくしちゃってさー。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.5.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうだったんだ。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.4.dialogue.5",
          "title": "重要表現 ②",
          "lines": [
            {
              "section": "うらやむ",
              "group": "①",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.6.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "沖縄、どうだった？" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.6.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "海がきれいで、ウミガメも見られたんだ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.6.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "へえ、ウミガメか、いいなあ。僕も、一度は見てみたいなあ。" }
              ]
            },
            {
              "group": "②",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.7.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "天神祭りの花火、すごかったよ。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.7.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えーっ、うらやましいなあ。私も一緒に行けばよかったなあ。" }
              ]
            },
            {
              "group": "③",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.8.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "どちらに行かれたんですか。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.8.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "ミラノに行ってきたんです。初めての海外旅行だったんですよ。" }
              ]
            },
            {
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.8.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うわー、ミラノなんて、うらやましいです。私もいつか行けるといいんですけど。" }
              ]
            },
            {
              "group": "④",
              "role": "A",
              "translationId": "nihongo-namachukei.4.dialogue.9.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "インドの国際会議でね、ガイドの人にタージ・マハルにも連れてってもらったんだよ。" }
              ]
            },
            {
              "role": "B",
              "translationId": "nihongo-namachukei.4.dialogue.9.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "うわー、タージ・マハルですか、いいですね。一度は行ってみたいところですよね。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    }
  }
}
