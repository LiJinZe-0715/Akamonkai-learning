{
  "kind": "lesson",
  "id": "nihongo-namachukei.3",
  "bookId": "nihongo-namachukei",
  "title": "LESSON 3 レストランで",
  "modules": {
    "articles": {
      "kind": "article-module",
      "items": [
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.0",
          "title": "聞き取り練習 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.0",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.1",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、まいど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.2",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "注文、お願いします。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.3",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、どうぞ。お飲み物は？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.4",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "えっと、生中と、レモンサワー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.5",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、かしこまりました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.6",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、この天ぷら盛り合わせって、何が入ってるんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.7",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "えっと、天ぷら盛り合わせは、エビ、タコ、イカと、それから、ナスと、シイタケですね。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.8",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あー、そうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.9",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.10",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、それから、もうひとつ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.11",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.12",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "これ、この気まぐれサラダって、何ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.13",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あっ、気まぐれサラダですね。えー、レタスに、大根、ツナ、トマトなんかが入っていまして、ドレッシングは和風ドレッシングです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.14",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.15",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。ご注文はいかがいたしましょう？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.16",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、もうちょっと待ってもらえます？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.0.paragraph.17",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、かしこまりました。じゃあ、お決まりになりましたら、お呼びください。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.1",
          "title": "聞き取り練習 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.0",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "俺、ブラジル料理食べるの、今日が初めてなんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.1",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんだ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.2",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.3",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "最近、けっこうこの辺にブラジルのお店、できてるよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.4",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "うん、気になってたんだけどさー。なんか、一人じゃ入りにくいしさー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.5",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そっか。じゃあ、よかったね、今日は私と一緒で。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.6",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "うん。なあ、これ、このフェジョ…フェジョアダ…って何？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.7",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "フェジョアーダ。豆の料理だよ。茶色い豆と豚肉とかが入ってて、煮込んであるの。ブラジルの代表的な料理だよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.8",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "へえ、どんな味なの？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.9",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "どんな？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.10",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.11",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "どんな味って言われてもねー。おいしいよ。うーん、あっ、日本の豆料理は、普通、甘いけど、ブラジルのは塩味なのよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.12",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "へえ、塩味か。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.13",
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "だから、初めて日本で豆の料理を食べたとき、甘かったから、すっごいびっくりした。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.1.paragraph.14",
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "わかるわかる。考えたのと全然違うときって、ほんとびっくりするよな。あっ、じゃあ、あのさあ、このコシニャって、写真だとコロッケみたいだけど、どんな食べ物？" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.2",
          "title": "聞き取り練習 ③",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.0",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "ご注文は？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.1",
              "role": "川村",
              "sentences": [
                { "kind": "sentence", "text": "鈴木さんは、何にする？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.2",
              "role": "鈴木",
              "sentences": [
                { "kind": "sentence", "text": "私はアイスコーヒーで。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.3",
              "role": "川村",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、僕はコーラ。で、氷抜きにしてくれる？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.4",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "アイスコーヒーと、コーラ、氷抜きですね。かしこまりました。" },
                { "kind": "sentence", "text": "お待たせしました。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.5",
              "role": "川村",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これ、氷入ってるよ。僕、氷は入れないでって言ったんだけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.6",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あっ、すみません。すぐ取り替えます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.7",
              "role": "川村",
              "sentences": [
                { "kind": "sentence", "text": "お願い。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.8",
              "role": "鈴木",
              "sentences": [
                { "kind": "sentence", "text": "川村さん、どうして、氷はだめなんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.9",
              "role": "川村",
              "sentences": [
                { "kind": "sentence", "text": "ほら、氷入ってると、どんどん薄くなっちゃうだろ。あれがいやなんだよ。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.10",
              "role": "鈴木",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.2.paragraph.11",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "すみません。お待たせしました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.3",
          "title": "聞き取り練習 ④",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.0",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、お待たせいたしました。ミートソースのお客様は？" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.1",
              "role": "客1",
              "sentences": [
                { "kind": "sentence", "text": "あっ、私。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.2",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、こちら、きのこパスタです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.3",
              "role": "客2",
              "sentences": [
                { "kind": "sentence", "text": "はい。あのう、トマトソースじゃなくて、クリームソースを頼んだと思うんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.4",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あっ、クリームソースですか。申し訳ありません。すぐに、お取り替えしますので。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.5",
              "role": "客2",
              "sentences": [
                { "kind": "sentence", "text": "あっ、いいですよ。これで。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.6",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "よろしいですか。申し訳ありません。" },
                { "kind": "sentence", "text": "お客様、あのう、もしよろしければ、デザートを2つサービスさせていただきたいと思うんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.7",
              "role": "客2",
              "sentences": [
                { "kind": "sentence", "text": "えっ、サービス？　いいんですか。すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.8",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "いえ。こちら、デザートのメニューです。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.3.paragraph.9",
              "role": "客2",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.4",
          "title": "重要表現 ①",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.0",
              "section": "質問する",
              "group": "①",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.1",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、何でしょうか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.2",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、このミニデザートって、何ですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.3",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "えっと、今日のデザートはカスタードプリンでございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.4",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.5",
              "group": "②",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あのう、このシニア・デーって、いつですか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.6",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "毎月、10日、20日、30日です。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.7",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "60歳以上の方のグループに限りって書いてますけど、一人でも若い人がいたらだめなんでしょうか。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.8",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、それはちょっと…。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.4.paragraph.9",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。わかりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "article",
          "id": "nihongo-namachukei.3.article.5",
          "title": "重要表現 ②",
          "paragraphs": [
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.0",
              "section": "相手の間違いを指摘する",
              "group": "①",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "お待たせいたしました。チキンバーガーのお客様。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.1",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "えっと、私が注文したの、チーズバーガーだったんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.2",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "あっ、申し訳ございません。すぐに取り替えます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.3",
              "group": "②",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "えっと、とりあえずビール、生で。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.4",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい、ビール。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.5",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、ビンじゃなくて、生ビール、注文したつもりだったんですが。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.6",
              "group": "③",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、カフェオレとアイスコーヒー。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.7",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "はい。カフェオレとアイスコーヒーでございますね。かしこまりました。" },
                { "kind": "sentence", "text": "お待たせいたしました。ホットコーヒーのお客様。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.8",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "ホットじゃなくて、アイスコーヒーを頼んだはずだったんですけど。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.9",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "申し訳ございません。すぐ取り替えます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.10",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "まあ、いいです。これで。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.11",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "申し訳ございませんでした。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.12",
              "group": "④",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "合計 1260 円でございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.13",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "えっと、はい。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.14",
              "role": "店員",
              "sentences": [
                { "kind": "sentence", "text": "お客様、あのう、1260 円でございます。" }
              ]
            },
            {
              "kind": "paragraph",
              "id": "nihongo-namachukei.3.article.5.paragraph.15",
              "role": "客",
              "sentences": [
                { "kind": "sentence", "text": "あっ、すみません。間違えました。" }
              ]
            }
          ],
          "questions": []
        }
      ]
    },
    "dialogues": {
      "kind": "dialogue-module",
      "items": [
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.0",
          "title": "聞き取り練習 ①",
          "lines": [
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、まいど。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "注文、お願いします。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、どうぞ。お飲み物は？" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、生中と、レモンサワー。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、かしこまりました。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、この天ぷら盛り合わせって、何が入ってるんですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、天ぷら盛り合わせは、エビ、タコ、イカと、それから、ナスと、シイタケですね。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "あー、そうですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、それから、もうひとつ。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "これ、この気まぐれサラダって、何ですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.13.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、気まぐれサラダですね。えー、レタスに、大根、ツナ、トマトなんかが入っていまして、ドレッシングは和風ドレッシングです。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.14.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.15.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。ご注文はいかがいたしましょう？" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.16.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、もうちょっと待ってもらえます？" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.0.line.17.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、かしこまりました。じゃあ、お決まりになりましたら、お呼びください。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.1",
          "title": "聞き取り練習 ②",
          "lines": [
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "俺、ブラジル料理食べるの、今日が初めてなんだ。" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうなんだ。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "最近、けっこうこの辺にブラジルのお店、できてるよ。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん、気になってたんだけどさー。なんか、一人じゃ入りにくいしさー。" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そっか。じゃあ、よかったね、今日は私と一緒で。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "うん。なあ、これ、このフェジョ…フェジョアダ…って何？" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "フェジョアーダ。豆の料理だよ。茶色い豆と豚肉とかが入ってて、煮込んであるの。ブラジルの代表的な料理だよ。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "へえ、どんな味なの？" }
              ]
            },
            {
              "role": "リサ",
              "sentences": [
                { "kind": "sentence", "text": "どんな？" }
              ]
            },
            {
              "role": "健二",
              "sentences": [
                { "kind": "sentence", "text": "うん。" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "どんな味って言われてもねー。おいしいよ。うーん、あっ、日本の豆料理は、普通、甘いけど、ブラジルのは塩味なのよ。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "へえ、塩味か。" }
              ]
            },
            {
              "role": "リサ",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "だから、初めて日本で豆の料理を食べたとき、甘かったから、すっごいびっくりした。" }
              ]
            },
            {
              "role": "健二",
              "translationId": "nihongo-namachukei.3.dialogue.1.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "わかるわかる。考えたのと全然違うときって、ほんとびっくりするよな。あっ、じゃあ、あのさあ、このコシニャって、写真だとコロッケみたいだけど、どんな食べ物？" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.2",
          "title": "聞き取り練習 ③",
          "lines": [
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "ご注文は？" }
              ]
            },
            {
              "role": "川村",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "鈴木さんは、何にする？" }
              ]
            },
            {
              "role": "鈴木",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "私はアイスコーヒーで。" }
              ]
            },
            {
              "role": "川村",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "じゃあ、僕はコーラ。で、氷抜きにしてくれる？" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "アイスコーヒーと、コーラ、氷抜きですね。かしこまりました。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "お待たせしました。" }
              ]
            },
            {
              "role": "川村",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、これ、氷入ってるよ。僕、氷は入れないでって言ったんだけど。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.7.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、すみません。すぐ取り替えます。" }
              ]
            },
            {
              "role": "川村",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.8.translation",
              "sentences": [
                { "kind": "sentence", "text": "お願い。" }
              ]
            },
            {
              "role": "鈴木",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.9.translation",
              "sentences": [
                { "kind": "sentence", "text": "川村さん、どうして、氷はだめなんですか。" }
              ]
            },
            {
              "role": "川村",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.10.translation",
              "sentences": [
                { "kind": "sentence", "text": "ほら、氷入ってると、どんどん薄くなっちゃうだろ。あれがいやなんだよ。" }
              ]
            },
            {
              "role": "鈴木",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.11.translation",
              "sentences": [
                { "kind": "sentence", "text": "そうなんですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.2.line.12.translation",
              "sentences": [
                { "kind": "sentence", "text": "すみません。お待たせしました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.3",
          "title": "聞き取り練習 ④",
          "lines": [
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、お待たせいたしました。ミートソースのお客様は？" }
              ]
            },
            {
              "role": "客1",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、私。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、こちら、きのこパスタです。" }
              ]
            },
            {
              "role": "客2",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい。あのう、トマトソースじゃなくて、クリームソースを頼んだと思うんですけど。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、クリームソースですか。申し訳ありません。すぐに、お取り替えしますので。" }
              ]
            },
            {
              "role": "客2",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.5.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、いいですよ。これで。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.3.line.6.translation",
              "sentences": [
                { "kind": "sentence", "text": "よろしいですか。申し訳ありません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.4.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "お客様、あのう、もしよろしければ、デザートを2つサービスさせていただきたいと思うんですが。" }
              ]
            },
            {
              "role": "客2",
              "translationId": "nihongo-namachukei.3.dialogue.4.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっ、サービス？　いいんですか。すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.4.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "いえ。こちら、デザートのメニューです。" }
              ]
            },
            {
              "role": "客2",
              "translationId": "nihongo-namachukei.3.dialogue.4.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "ありがとうございます。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.4",
          "title": "重要表現 ①",
          "lines": [
            {
              "section": "質問する",
              "group": "①",
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.9.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、すみません。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.9.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、何でしょうか。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.9.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、このミニデザートって、何ですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.9.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、今日のデザートはカスタードプリンでございます。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.9.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。" }
              ]
            },
            {
              "group": "②",
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.10.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "あのう、このシニア・デーって、いつですか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.10.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "毎月、10日、20日、30日です。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.10.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "60歳以上の方のグループに限りって書いてますけど、一人でも若い人がいたらだめなんでしょうか。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.10.line.3.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、それはちょっと…。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.10.line.4.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、そうですか。わかりました。" }
              ]
            }
          ],
          "questions": []
        },
        {
          "kind": "dialogue",
          "id": "nihongo-namachukei.3.dialogue.5",
          "title": "重要表現 ②",
          "lines": [
            {
              "section": "相手の間違いを指摘する",
              "group": "①",
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.5.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "お待たせいたしました。チキンバーガーのお客様。" }
              ]
            },
            {
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.5.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、私が注文したの、チーズバーガーだったんですが。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.5.line.2.translation",
              "sentences": [
                { "kind": "sentence", "text": "あっ、申し訳ございません。すぐに取り替えます。" }
              ]
            },
            {
              "group": "②",
              "role": "客",
              "translationId": "nihongo-namachukei.3.dialogue.6.line.0.translation",
              "sentences": [
                { "kind": "sentence", "text": "えっと、とりあえずビール、生で。" }
              ]
            },
            {
              "role": "店員",
              "translationId": "nihongo-namachukei.3.dialogue.6.line.1.translation",
              "sentences": [
                { "kind": "sentence", "text": "はい、ビール。" }
              ]
            },
