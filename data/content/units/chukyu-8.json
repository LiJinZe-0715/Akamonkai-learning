  "articles": [
    {
      "id": "chukyu.lesson.8.grammar.0",
      "titleJa": "～にすぎない",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.0.meaning",
        "chukyu.lesson.8.grammar.0.connection",
        "chukyu.lesson.8.grammar.0.note"
      ],
      "examples": [
        {
          "ja": "言語的な要素から相手を判断する人はわずか数パーセントにすぎない。",
          "translationId": "chukyu.lesson.8.grammar.0.example.0"
        },
        {
          "ja": "彼のスピーチは他の人のまねをしたにすぎない。",
          "translationId": "chukyu.lesson.8.grammar.0.example.1"
        },
        {
          "ja": "アルバイトの収入は１か月２万円（である）にすぎない。",
          "translationId": "chukyu.lesson.8.grammar.0.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.grammar.1",
      "titleJa": "Nさえ～ば／～なら",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.1.meaning",
        "chukyu.lesson.8.grammar.1.connection",
        "chukyu.lesson.8.grammar.1.note"
      ],
      "examples": [
        {
          "ja": "服装さえ気をつければいい。",
          "translationId": "chukyu.lesson.8.grammar.1.example.0"
        },
        {
          "ja": "天気さえよければ、ここから島が見える。",
          "translationId": "chukyu.lesson.8.grammar.1.example.1"
        },
        {
          "ja": "体さえ丈夫なら、どんなことでもできる。",
          "translationId": "chukyu.lesson.8.grammar.1.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.grammar.2",
      "titleJa": "「さえ・しか・こそ」の整理",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.2.meaning",
        "chukyu.lesson.8.grammar.2.connection",
        "chukyu.lesson.8.grammar.2.note"
      ],
      "examples": [
        {
          "ja": "ひらがなさえ読めれば、この絵本は読める。",
          "translationId": "chukyu.lesson.8.grammar.2.example.0"
        },
        {
          "ja": "ひらがなしか読めない。",
          "translationId": "chukyu.lesson.8.grammar.2.example.1"
        },
        {
          "ja": "漢字学習こそ大切だと思っている学生がいる。",
          "translationId": "chukyu.lesson.8.grammar.2.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.grammar.3",
      "titleJa": "～というものではない・～というものでもない",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.3.meaning",
        "chukyu.lesson.8.grammar.3.connection",
        "chukyu.lesson.8.grammar.3.note"
      ],
      "examples": [
        {
          "ja": "服装さえ気をつければいいというものではない。",
          "translationId": "chukyu.lesson.8.grammar.3.example.0"
        },
        {
          "ja": "外国語はその国に住めば上手になるというものでもない。",
          "translationId": "chukyu.lesson.8.grammar.3.example.1"
        },
        {
          "ja": "有名な大学を卒業した人が優秀（だ）というものでもない。",
          "translationId": "chukyu.lesson.8.grammar.3.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.grammar.4",
      "titleJa": "Vます形＋かねない",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.4.meaning",
        "chukyu.lesson.8.grammar.4.connection",
        "chukyu.lesson.8.grammar.4.note"
      ],
      "examples": [
        {
          "ja": "椅子の背もたれに寄りかかりすぎると、威圧感を与えかねない。",
          "translationId": "chukyu.lesson.8.grammar.4.example.0"
        },
        {
          "ja": "そんなことを言うと、誤解を招きかねない。",
          "translationId": "chukyu.lesson.8.grammar.4.example.1"
        },
        {
          "ja": "栄養のバランスを考えないで食事をしていると、病気になりかねない。",
          "translationId": "chukyu.lesson.8.grammar.4.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.grammar.5",
      "titleJa": "～ものの",
      "paragraphIds": [
        "chukyu.lesson.8.grammar.5.meaning",
        "chukyu.lesson.8.grammar.5.connection",
        "chukyu.lesson.8.grammar.5.note"
      ],
      "examples": [
        {
          "ja": "「人間は中身が大切だ」と言われているものの、見た目や話し方が人の第一印象を左右する。",
          "translationId": "chukyu.lesson.8.grammar.5.example.0"
        },
        {
          "ja": "今の会社は給料はあまり高くないものの、人間関係はいいので、満足している。",
          "translationId": "chukyu.lesson.8.grammar.5.example.1"
        },
        {
          "ja": "彼は言葉遣いは丁寧なものの、態度がよくないので、印象が悪い。",
          "translationId": "chukyu.lesson.8.grammar.5.example.2"
        }
      ],
      "children": []
    },
    {
      "id": "chukyu.lesson.8.exercises",
      "titleJa": "教材の穴埋め練習",
      "paragraphIds": [
        "chukyu.lesson.8.exerciseInstructions"
      ],
      "examples": [
        {
          "ja": "先生は学生と目を（　　　）、ほほえんだ。",
          "answerJa": "合わせて",
          "analysisId": "chukyu.lesson.8.exercise.0.note"
        },
        {
          "ja": "ドアに（　　　）ないでください。危険です。",
          "answerJa": "寄りかから",
          "analysisId": "chukyu.lesson.8.exercise.1.note"
        },
        {
          "ja": "この会社はデータによって全てのことを（　　　）いる。",
          "answerJa": "決定して",
          "analysisId": "chukyu.lesson.8.exercise.2.note"
        },
        {
          "ja": "自信がない時、私は前かがみの（　　　）になってしまう。",
          "answerJa": "姿勢",
          "analysisId": "chukyu.lesson.8.exercise.3.note"
        },
        {
          "ja": "私は「人間は見た目より（　　　）が大切だ」と思う。",
          "answerJa": "中身",
          "analysisId": "chukyu.lesson.8.exercise.4.note"
        },
        {
          "ja": "動物の赤ちゃんの（　　　）は愛らしい。",
          "answerJa": "動作",
          "analysisId": "chukyu.lesson.8.exercise.5.note"
        },
        {
          "ja": "Aさんは（　　　）なので、やる気があるかどうか分かりにくい。",
          "answerJa": "無表情",
          "analysisId": "chukyu.lesson.8.exercise.6.note"
        }
      ],
      "children": []
    }
  ],
