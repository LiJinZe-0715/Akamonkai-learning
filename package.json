    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "pnpm": ">=12.15.0 <13"
  }
